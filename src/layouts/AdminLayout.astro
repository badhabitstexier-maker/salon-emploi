---
import Seo from '../components/Seo.astro';
import '../styles/global.css';

interface Props {
  title: string;
}

// Espace interne LabEvents : toujours noindex, quel que soit PUBLIC_NOINDEX
// (voir docs/ADMIN.md — la vraie barrière reste l'authentification serveur
// .htaccess, pas cette balise, qui n'empêche que l'indexation).
const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Seo title={`Admin — ${title}`} description="Espace interne LabEvents — accès réservé." noindex={true} />
  </head>
  <body class="min-h-screen bg-brume text-encre">
    <header class="border-b border-marine/20 bg-marine text-blanc">
      <div class="mx-auto flex h-14 max-w-6xl items-center px-4 sm:px-6">
        <p class="text-sm font-bold uppercase tracking-wide">Admin LabEvents — Salon Emploi &amp; Formation 2026</p>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
      <slot />
    </main>
  </body>
</html>
