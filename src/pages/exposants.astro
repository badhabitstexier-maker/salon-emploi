---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExposantCard from '../components/ExposantCard.astro';
import {
  getExposantsPublies,
  trierExposants,
  secteursDisponibles,
  universLabels,
  typeStructureLabels,
} from '../lib/exposants';

const exposants = trierExposants(await getExposantsPublies());
const total = exposants.length;
const totalHall = exposants.filter((e) => e.data.univers === 'hall').length;
const totalVillage = exposants.filter((e) => e.data.univers === 'village').length;

const secteurs = secteursDisponibles(exposants);

const infosSalon = [
  'Hall Emploi & Formation',
  'Village Maintenance & Industrie',
  '30 et 31 octobre 2026',
  'Nouville — Nouméa',
];
---

<BaseLayout
  title="Exposants"
  description="Découvrez les entreprises, organismes de formation, institutions et acteurs présents au Salon de l'Emploi & de la Formation 2026 à Nouméa."
>
  <!-- ============================== HERO ============================== -->
  <section class="bg-marine text-blanc">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-20">
      <p class="text-xs font-bold uppercase tracking-widest text-orange">Les exposants</p>
      <h1 class="mt-3 max-w-3xl font-titre text-4xl font-bold uppercase leading-none sm:text-5xl xl:text-6xl">
        Rencontrez les acteurs de l'emploi et de la formation
      </h1>

      <p class="mt-6 max-w-2xl text-base text-brume sm:text-lg">
        Entreprises, organismes de formation, institutions et structures d'accompagnement seront
        réunis pour présenter leurs métiers, leurs parcours et leurs opportunités.
      </p>
      <p class="mt-4 max-w-2xl text-sm italic text-brume/80">
        La liste des exposants sera enrichie au fur et à mesure des confirmations.
      </p>

      <ul class="mt-8 grid grid-cols-2 gap-x-6 gap-y-3 text-sm font-semibold uppercase tracking-wide text-brume sm:flex sm:flex-wrap sm:gap-x-8">
        {
          infosSalon.map((info) => (
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-orange" aria-hidden="true" />
              {info}
            </li>
          ))
        }
      </ul>

      <div class="mt-9">
        <a
          href="/exposer#demande-exposant"
          class="inline-flex items-center justify-center rounded-md bg-village px-6 py-3.5 text-center font-titre text-lg font-bold uppercase tracking-wide text-blanc transition-opacity hover:opacity-90"
        >
          Devenir exposant
        </a>
      </div>
    </div>
  </section>

  <!-- ============================ COMPTEUR ============================= -->
  <section class="border-b border-marine/10 bg-brume">
    <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
      {
        total > 0 ? (
          <p class="text-center text-sm font-semibold text-marine sm:text-base">
            <span class="font-titre text-lg font-bold text-orange">{total}</span>{' '}
            {total > 1 ? 'exposants confirmés' : 'exposant confirmé'}
            {(totalHall > 0 || totalVillage > 0) && (
              <span class="text-encre/70">
                {' — '}
                {totalHall} {universLabels.hall} · {totalVillage} {universLabels.village}
              </span>
            )}
          </p>
        ) : (
          <p class="text-center text-sm font-semibold text-marine sm:text-base">
            La liste des exposants sera publiée progressivement à l'approche du salon.
          </p>
        )
      }
    </div>
  </section>

  {
    total > 0 ? (
      <section class="bg-blanc">
        <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
          <!-- ==================== RECHERCHE ET FILTRES ==================== -->
          <form id="filtres-exposants" class="rounded-2xl border border-marine/15 bg-brume p-5 sm:p-6">
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              <div class="lg:col-span-2">
                <label for="recherche-exposant" class="block text-xs font-bold uppercase tracking-wide text-marine">
                  Rechercher
                </label>
                <input
                  id="recherche-exposant"
                  name="recherche"
                  type="search"
                  placeholder="Nom, secteur, mot-clé…"
                  class="mt-1.5 w-full rounded-md border border-marine/20 bg-blanc px-3 py-2.5 text-sm text-encre focus:border-marine focus:outline-none focus:ring-2 focus:ring-marine/30"
                />
              </div>

              <div>
                <label for="filtre-univers" class="block text-xs font-bold uppercase tracking-wide text-marine">
                  Univers
                </label>
                <select
                  id="filtre-univers"
                  name="univers"
                  class="mt-1.5 w-full rounded-md border border-marine/20 bg-blanc px-3 py-2.5 text-sm text-encre focus:border-marine focus:outline-none focus:ring-2 focus:ring-marine/30"
                >
                  <option value="">Tous</option>
                  <option value="hall">{universLabels.hall}</option>
                  <option value="village">{universLabels.village}</option>
                </select>
              </div>

              <div>
                <label for="filtre-type" class="block text-xs font-bold uppercase tracking-wide text-marine">
                  Type de structure
                </label>
                <select
                  id="filtre-type"
                  name="type"
                  class="mt-1.5 w-full rounded-md border border-marine/20 bg-blanc px-3 py-2.5 text-sm text-encre focus:border-marine focus:outline-none focus:ring-2 focus:ring-marine/30"
                >
                  <option value="">Tous</option>
                  {Object.entries(typeStructureLabels).map(([valeur, label]) => (
                    <option value={valeur}>{label}</option>
                  ))}
                </select>
              </div>

              {secteurs.length > 0 && (
                <div>
                  <label for="filtre-secteur" class="block text-xs font-bold uppercase tracking-wide text-marine">
                    Secteur
                  </label>
                  <select
                    id="filtre-secteur"
                    name="secteur"
                    class="mt-1.5 w-full rounded-md border border-marine/20 bg-blanc px-3 py-2.5 text-sm text-encre focus:border-marine focus:outline-none focus:ring-2 focus:ring-marine/30"
                  >
                    <option value="">Tous</option>
                    {secteurs.map((secteur) => (
                      <option value={secteur}>{secteur}</option>
                    ))}
                  </select>
                </div>
              )}
            </div>

            <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
              <p id="resultats-compte" class="text-sm font-semibold text-marine" aria-live="polite">
                {total} {total > 1 ? 'résultats' : 'résultat'}
              </p>
              <button
                type="reset"
                id="reinitialiser-filtres"
                class="rounded-md border border-marine/30 px-4 py-2 text-sm font-semibold text-marine transition-colors hover:bg-marine hover:text-blanc"
              >
                Réinitialiser les filtres
              </button>
            </div>
          </form>

          <!-- ========================= GRILLE ========================= -->
          <div id="grille-exposants" class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {exposants.map((exposant) => <ExposantCard exposant={exposant} />)}
          </div>

          <p id="aucun-resultat" class="mt-8 hidden rounded-2xl border border-marine/15 bg-brume p-8 text-center text-sm text-encre">
            Aucun exposant ne correspond à votre recherche. Essayez d'autres mots-clés ou
            réinitialisez les filtres.
          </p>
        </div>

        <script>
          const form = document.getElementById('filtres-exposants') as HTMLFormElement | null;
          const grille = document.getElementById('grille-exposants');
          const compte = document.getElementById('resultats-compte');
          const aucunResultat = document.getElementById('aucun-resultat');
          const champRecherche = document.getElementById('recherche-exposant') as HTMLInputElement | null;

          if (form && grille && compte && aucunResultat) {
            const cartes = Array.from(grille.querySelectorAll<HTMLElement>('[data-exposant-card]'));

            const normaliser = (valeur: string) =>
              valeur
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '');

            const appliquerFiltres = () => {
              const donnees = new FormData(form);
              const recherche = normaliser(String(donnees.get('recherche') ?? '').trim());
              const univers = String(donnees.get('univers') ?? '');
              const type = String(donnees.get('type') ?? '');
              const secteur = String(donnees.get('secteur') ?? '');

              let visibles = 0;

              for (const carte of cartes) {
                const matchRecherche = !recherche || (carte.dataset.search ?? '').includes(recherche);
                const matchUnivers = !univers || carte.dataset.univers === univers;
                const matchType = !type || carte.dataset.type === type;
                const secteursCarte = (carte.dataset.secteurs ?? '').split('|');
                const matchSecteur = !secteur || secteursCarte.includes(secteur);

                const visible = matchRecherche && matchUnivers && matchType && matchSecteur;
                carte.classList.toggle('hidden', !visible);
                if (visible) visibles += 1;
              }

              compte.textContent = `${visibles} ${visibles > 1 || visibles === 0 ? 'résultats' : 'résultat'}`;
              aucunResultat.classList.toggle('hidden', visibles !== 0);
            };

            form.addEventListener('input', appliquerFiltres);
            form.addEventListener('change', appliquerFiltres);
            form.addEventListener('reset', () => {
              window.setTimeout(appliquerFiltres, 0);
              champRecherche?.focus();
            });

            appliquerFiltres();
          }
        </script>
      </section>
    ) : (
      <section class="bg-blanc">
        <div class="mx-auto max-w-2xl px-4 py-16 text-center sm:px-6 lg:py-20">
          <h2 class="font-titre text-2xl font-bold uppercase text-marine sm:text-3xl">
            Les premiers exposants seront annoncés prochainement
          </h2>
          <p class="mt-4 text-encre">
            La liste sera mise à jour au fur et à mesure des confirmations. Revenez prochainement
            pour découvrir les entreprises, organismes de formation, institutions et acteurs
            présents.
          </p>
          <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            <a
              href="/exposer#demande-exposant"
              class="inline-flex items-center justify-center rounded-md bg-village px-6 py-3.5 font-titre text-lg font-bold uppercase tracking-wide text-blanc transition-opacity hover:opacity-90"
            >
              Devenir exposant
            </a>
            <a
              href="/le-salon"
              class="inline-flex items-center justify-center rounded-md border-2 border-marine px-6 py-3.5 font-titre text-lg font-bold uppercase tracking-wide text-marine transition-colors hover:bg-marine hover:text-blanc"
            >
              Découvrir le salon
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- ======================= BLOC FINAL EXPOSANTS ======================= -->
  <section class="border-t border-marine/10 bg-marine text-blanc">
    <div class="mx-auto max-w-4xl px-4 py-14 text-center sm:px-6 lg:py-16">
      <h2 class="font-titre text-3xl font-bold uppercase sm:text-4xl">
        Vous souhaitez participer au salon ?
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base text-brume sm:text-lg">
        Présentez vos emplois, vos formations, vos métiers ou vos dispositifs aux publics du
        territoire.
      </p>
      <div class="mt-8">
        <a
          href="/exposer#demande-exposant"
          class="inline-flex items-center justify-center rounded-md bg-village px-6 py-3.5 font-titre text-lg font-bold uppercase tracking-wide text-blanc transition-opacity hover:opacity-90"
        >
          Demander un stand
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
