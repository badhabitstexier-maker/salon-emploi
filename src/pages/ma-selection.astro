---
import BaseLayout from '../layouts/BaseLayout.astro';
import OffreSelection from '../components/OffreSelection.astro';
import { getOffresPubliees, offreSlug } from '../lib/offres';

const offres = await getOffresPubliees();

const offresDisponibles = offres.map((offre) => ({
  reference: offre.data.reference,
  intitule: offre.data.intitule,
  exposantNom: offre.data.exposantNom,
  href: `/offres/${offreSlug(offre)}`,
}));
---

<BaseLayout
  title="Ma sélection"
  description="Retrouvez les offres du Salon de l'Emploi & de la Formation 2026 que vous avez sélectionnées."
>
  <section class="bg-marine text-blanc">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:py-20">
      <p class="text-xs font-bold uppercase tracking-widest text-orange">Offres et candidatures</p>
      <h1 class="mt-3 font-titre text-4xl font-bold uppercase leading-none sm:text-5xl">Ma sélection</h1>
      <p class="mt-4 font-titre text-lg font-bold uppercase tracking-wide text-brume">
        <span data-compteur-selection>0/5</span> offres sélectionnées
      </p>
    </div>
  </section>

  <section class="bg-blanc">
    <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:py-14">
      <div data-selection-vide class="hidden rounded-2xl border border-marine/15 bg-brume p-8 text-center">
        <h2 class="font-titre text-xl font-bold uppercase text-marine">
          Vous n'avez sélectionné aucune offre pour l'instant
        </h2>
        <p class="mt-3 text-sm text-encre">
          Parcourez le catalogue des offres du salon et ajoutez jusqu'à cinq offres à votre
          sélection.
        </p>
        <div class="mt-6">
          <a
            href="/offres"
            data-preserve-selection
            data-href-base="/offres"
            class="inline-flex items-center justify-center rounded-md bg-marine px-6 py-3 font-titre text-base font-bold uppercase tracking-wide text-blanc transition-opacity hover:opacity-90"
          >
            Voir les offres du salon
          </a>
        </div>
      </div>

      <div data-selection-presente class="hidden">
        <ul data-liste-selection class="grid grid-cols-1 gap-4 sm:grid-cols-2" aria-label="Offres sélectionnées"></ul>

        <div class="mt-8 flex flex-col gap-3 border-t border-marine/10 pt-8 sm:flex-row sm:items-center">
          <button
            type="button"
            disabled
            aria-disabled="true"
            title="Le formulaire de candidature sera disponible au Lot 2 (/candidater)."
            class="inline-flex cursor-not-allowed items-center justify-center rounded-md bg-village/50 px-6 py-3 font-titre text-base font-bold uppercase tracking-wide text-marine/60"
          >
            Candidater à ma sélection — Bientôt disponible
          </button>
          <a
            href="/offres"
            data-preserve-selection
            data-href-base="/offres"
            class="inline-flex items-center justify-center rounded-md border-2 border-marine px-6 py-3 font-titre text-base font-bold uppercase tracking-wide text-marine transition-colors hover:bg-marine hover:text-blanc"
          >
            Voir toutes les offres
          </a>
        </div>
      </div>

      <div class="mt-10 rounded-2xl border border-marine/15 bg-brume p-6 sm:p-8">
        <h2 class="font-titre text-lg font-bold uppercase text-marine">
          Je n'ai pas trouvé d'offre correspondant à mon profil
        </h2>
        <p class="mt-3 text-sm text-encre">
          Vous pourrez prochainement candidater sans sélectionner d'offre précise, pour être orienté
          par l'équipe du salon.
        </p>
        <button
          type="button"
          disabled
          aria-disabled="true"
          title="Ce parcours sera disponible au Lot 2 (/candidater?orientation=1)."
          class="mt-4 inline-flex cursor-not-allowed items-center justify-center rounded-md border-2 border-marine/30 px-6 py-3 font-titre text-base font-bold uppercase tracking-wide text-marine/60"
        >
          Candidater sans offre — Bientôt disponible
        </button>
      </div>
    </div>
  </section>

  <OffreSelection />
  <script type="application/json" id="offres-disponibles-donnees" set:html={JSON.stringify(offresDisponibles)} />
  <p id="annonce-selection" class="sr-only" role="status" aria-live="polite"></p>
  <script>
    import { initSelectionUI } from '../lib/selection-ui';
    initSelectionUI();
  </script>
</BaseLayout>
