---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Visuel from '../../components/Visuel.astro';
import OffreCard from '../../components/OffreCard.astro';
import SelectionDrawer from '../../components/SelectionDrawer.astro';
import {
  getExposantsPublies,
  offresPublieesDeExposant,
  exposantSlug,
  universLabels,
  typeStructureLabels,
  formulePubliqueLabels,
  type Exposant,
} from '../../lib/exposants';
import { getOffresPubliees } from '../../lib/offres';

export async function getStaticPaths() {
  const exposants = await getExposantsPublies();
  const offresPubliees = await getOffresPubliees();
  return exposants.map((exposant) => ({
    params: { slug: exposantSlug(exposant) },
    props: { exposant, offresPubliees },
  }));
}

interface Props {
  exposant: Exposant;
  offresPubliees: Awaited<ReturnType<typeof getOffresPubliees>>;
}

const { exposant, offresPubliees } = Astro.props;
const { data } = exposant;

/*
  Contenu différencié par statut (section 5 du Lot « exposants-statuts »,
  voir CLAUDE.md) : chaque bloc n'est rendu que s'il est à la fois autorisé
  pour le statut ET renseigné — jamais de bloc vide pour montrer qu'une
  fonctionnalité existe.
*/
const estPartenaireOuPlus = data.formule === 'silver' || data.formule === 'gold';
const estPremium = data.formule === 'gold';

const afficherReseauxSociaux = estPartenaireOuPlus && data.reseaux_sociaux.length > 0;
const afficherLienRecrutement = estPartenaireOuPlus && Boolean(data.lien_recrutement);
const afficherPresentationLongue = estPremium && Boolean(data.description && data.description.trim() !== '');
const afficherCouverture = estPremium;
const afficherGalerie = estPremium && data.galerie.length > 0;

const offres = offresPublieesDeExposant(exposant, offresPubliees);

const styleUnivers = {
  emploi: { badge: 'bg-marine text-blanc', accent: 'text-orange' },
  formation: { badge: 'bg-village-dark text-blanc', accent: 'text-village' },
}[data.univers];

const reseauLabels: Record<Exposant['data']['reseaux_sociaux'][number]['plateforme'], string> = {
  facebook: 'Facebook',
  instagram: 'Instagram',
  linkedin: 'LinkedIn',
  tiktok: 'TikTok',
  youtube: 'YouTube',
  autre: 'Autre lien',
};

const listesComplementaires = [
  { titre: 'Métiers présentés', valeurs: data.metiers },
  { titre: 'Formations proposées', valeurs: data.formations },
  { titre: 'Opportunités', valeurs: data.opportunites },
].filter((bloc) => bloc.valeurs && bloc.valeurs.length > 0);

const formateurDate = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' });
const dateMiseAJour = data.date_mise_a_jour ? formateurDate.format(data.date_mise_a_jour) : null;
---

<BaseLayout
  title={data.nom}
  description={data.accroche}
  noindex={data.demo}
>
  {
    afficherCouverture && (
      <Visuel
        src={data.image_couverture ?? '/images/exposants/couverture-a-venir.webp'}
        alt=""
        width={1600}
        height={500}
        class="h-48 w-full sm:h-64 lg:h-80"
        loading="eager"
      />
    )
  }

  <section class="bg-marine text-blanc">
    <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:py-14">
      <a
        href="/exposants"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-brume underline decoration-brume/40 underline-offset-4 transition-colors hover:text-blanc hover:decoration-blanc"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Voir tous les exposants
      </a>

      {
        data.demo && (
          <p class="mt-4 w-fit rounded-full bg-orange px-3 py-1 text-xs font-bold uppercase tracking-wide text-marine">
            Fiche de démonstration
          </p>
        )
      }

      <div class="mt-6 flex flex-wrap items-start gap-6">
        {
          data.logo && (
            <div class="flex h-24 w-24 flex-shrink-0 items-center justify-center rounded-xl bg-blanc p-3">
              <img src={data.logo} alt="" class="max-h-full max-w-full object-contain" />
            </div>
          )
        }

        <div>
          <div class="flex flex-wrap items-center gap-2">
            <span class:list={['w-fit rounded-full px-2.5 py-1 text-xs font-bold uppercase tracking-wide', styleUnivers.badge]}>
              {universLabels[data.univers]}
            </span>
            {
              data.formule !== 'standard' && (
                <span class="w-fit rounded-full border border-blanc/30 px-2.5 py-1 text-xs font-semibold text-brume">
                  {formulePubliqueLabels[data.formule]}
                </span>
              )
            }
          </div>
          <h1 class="mt-3 font-titre text-3xl font-bold uppercase leading-none sm:text-4xl">
            {data.nom}
          </h1>
          <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-brume/80">
            {typeStructureLabels[data.type_structure]}
          </p>
        </div>
      </div>

      <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold text-brume">
        {
          data.secteurs.length > 0 && (
            <li class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-orange" aria-hidden="true" />
              {data.secteurs.join(' · ')}
            </li>
          )
        }
        {
          data.numero_stand && (
            <li class:list={['flex items-center gap-2 font-bold', styleUnivers.accent]}>
              <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-orange" aria-hidden="true" />
              Stand {data.numero_stand}
            </li>
          )
        }
      </ul>
    </div>
  </section>

  <section class="bg-blanc">
    <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:py-14">
      {
        data.demo && (
          <p class="mb-8 rounded-2xl border border-marine/15 bg-brume p-4 text-sm text-encre">
            Entreprise fictive — cette fiche illustre les possibilités de présentation proposées aux exposants
            du Salon de l'Emploi & de la Formation 2026.
          </p>
        )
      }

      <p class="text-lg font-semibold text-marine">{data.accroche}</p>

      {
        afficherPresentationLongue && (
          <div class="mt-6 space-y-4 text-encre">
            {data.description!.split(/\n{2,}/).map((paragraphe) => <p>{paragraphe}</p>)}
          </div>
        )
      }

      {
        afficherGalerie && (
          <div class="mt-10">
            <h2 class="font-titre text-lg font-bold uppercase text-marine">Galerie</h2>
            <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {data.galerie.map((image) => (
                <Visuel
                  src={image.src}
                  alt={image.alt}
                  width={480}
                  height={360}
                  class="aspect-[4/3] w-full rounded-xl"
                />
              ))}
            </div>
          </div>
        )
      }

      {
        listesComplementaires.length > 0 && (
          <div class="mt-10 grid gap-6 sm:grid-cols-2">
            {listesComplementaires.map((bloc) => (
              <div class="rounded-2xl border border-marine/15 bg-brume p-5">
                <h2 class="font-titre text-lg font-bold uppercase text-marine">{bloc.titre}</h2>
                <ul class="mt-3 space-y-1.5 text-sm text-encre">
                  {bloc.valeurs!.map((valeur) => (
                    <li class="flex items-start gap-2">
                      <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-orange" aria-hidden="true" />
                      <span>{valeur}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )
      }

      {
        (data.site_web || data.email_public || data.telephone_public || afficherLienRecrutement || afficherReseauxSociaux) && (
          <div class="mt-10 rounded-2xl border border-marine/15 bg-brume p-5">
            <h2 class="font-titre text-lg font-bold uppercase text-marine">Contact</h2>
            <ul class="mt-3 space-y-1.5 text-sm text-encre">
              {data.site_web && (
                <li>
                  <a href={data.site_web} class="font-semibold text-marine underline" target="_blank" rel="noopener noreferrer">
                    {data.site_web}
                  </a>
                </li>
              )}
              {data.email_public && (
                <li>
                  <a href={`mailto:${data.email_public}`} class="font-semibold text-marine underline">
                    {data.email_public}
                  </a>
                </li>
              )}
              {data.telephone_public && (
                <li>
                  <a href={`tel:${data.telephone_public.replace(/\s+/g, '')}`} class="font-semibold text-marine underline">
                    {data.telephone_public}
                  </a>
                </li>
              )}
              {afficherLienRecrutement && (
                <li>
                  <a
                    href={data.lien_recrutement}
                    class="font-semibold text-marine underline"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Recrutement — en savoir plus
                  </a>
                </li>
              )}
            </ul>
            {
              afficherReseauxSociaux && (
                <ul class="mt-4 flex flex-wrap gap-3 border-t border-marine/10 pt-4 text-sm">
                  {data.reseaux_sociaux.map((reseau) => (
                    <li>
                      <a
                        href={reseau.url}
                        class="font-semibold text-marine underline"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {reseauLabels[reseau.plateforme]}
                      </a>
                    </li>
                  ))}
                </ul>
              )
            }
          </div>
        )
      }

      {
        offres.length > 0 && (
          <div class="mt-10">
            <h2 class="font-titre text-lg font-bold uppercase text-marine">
              Offres d'emploi ({offres.length})
            </h2>
            <div class="mt-4 grid gap-6 sm:grid-cols-2">
              {offres.map((offre) => <OffreCard offre={offre} />)}
            </div>
          </div>
        )
      }

      {
        dateMiseAJour && (
          <p class="mt-8 text-xs text-encre/70">Fiche mise à jour le {dateMiseAJour}.</p>
        )
      }

      <div class="mt-10 flex flex-col gap-3 border-t border-marine/10 pt-8 sm:flex-row">
        <a
          href="/exposants"
          class="inline-flex items-center justify-center rounded-md bg-marine px-6 py-3 font-titre text-base font-bold uppercase tracking-wide text-blanc transition-opacity hover:opacity-90"
        >
          Voir tous les exposants
        </a>
      </div>
    </div>
  </section>

  {
    offres.length > 0 && (
      <Fragment>
        <SelectionDrawer />
        <script
          type="application/json"
          id="offres-disponibles-donnees"
          set:html={JSON.stringify(
            offres.map((offre) => ({
              reference: offre.data.reference,
              intitule: offre.data.intitule,
              exposantNom: offre.data.exposantNom,
              href: `/offres/${offre.id}`,
            })),
          )}
        />
        <script>
          import { initSelectionUI } from '../../lib/selection-ui';
          initSelectionUI();
        </script>
      </Fragment>
    )
  }
</BaseLayout>
