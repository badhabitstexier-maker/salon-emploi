---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Exposer"
  description="Devenez exposant au Salon de l'Emploi & de la Formation 2026 à Nouméa. Formulaire de contact à venir."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-bold text-marine sm:text-4xl">Exposer</h1>
    <p class="mt-6 max-w-2xl text-encre">
      {'{{À COMPLÉTER : bénéfices exposants, formules, formulaire — contenu du Lot 2}}'}
    </p>
  </section>
</BaseLayout>
