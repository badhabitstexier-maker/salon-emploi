---
import BaseLayout from '../layouts/BaseLayout.astro';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';

/*
  Redirections Web3Forms (fallback sans JavaScript uniquement — le script en
  fin de page intercepte l'envoi via fetch et n'y a normalement pas recours).
  Construites depuis `Astro.site` (lui-même dérivé de PUBLIC_SITE_URL, voir
  astro.config.mjs) pour ne jamais coder un domaine en dur : la préproduction
  redirige vers preprod.salonemploinc.com, la production vers son propre domaine.
*/
const redirectExposant = new URL('/merci?type=exposant', Astro.site).toString();
const redirectVisiteur = new URL('/merci?type=visiteur', Astro.site).toString();

/*
  Pack commercial exposants 2026 — fichier réel déposé dans
  public/documents/Pack_commercial_exposants_2026.pdf : lien statique direct,
  sans vérification au build.
*/
const packCommercial = {
  label: 'Pack commercial exposants 2026',
  href: '/documents/Pack_commercial_exposants_2026.pdf',
};

const chiffresCles = [
  { value: '12', unite: 'Éditions', label: 'depuis 2010' },
  { value: '3 000', unite: 'Visiteurs', label: 'attendus (environ)' },
  { value: '2', unite: 'Jours', label: 'de rencontres' },
  { value: '37', unite: 'Emplacements', label: 'commercialisés' },
  { value: '100 %', unite: 'Gratuit', label: 'entrée visiteurs' },
];

const raisons = [
  {
    verbe: 'Rencontrer',
    complement: 'vos futurs collaborateurs',
    texte: 'Échangez en direct avec des candidats motivés et présentez vos opportunités de recrutement.',
    icone: `<circle cx="8" cy="8" r="3" /><circle cx="17" cy="9" r="2.5" /><path stroke-linecap="round" d="M2.5 20a5.5 5.5 0 0 1 11 0M14.5 20a4.2 4.2 0 0 1 7-3.1" />`,
  },
  {
    verbe: 'Faire découvrir',
    complement: 'vos métiers',
    texte: 'Valorisez vos métiers, votre savoir-faire et votre marque employeur auprès des publics du salon.',
    icone: `<circle cx="12" cy="9" r="5" /><path stroke-linecap="round" stroke-linejoin="round" d="m8.3 13.2-1.6 7.3 5.3-3 5.3 3-1.6-7.3" />`,
  },
  {
    verbe: 'Créer',
    complement: 'des contacts utiles',
    texte: 'Développez votre réseau avec les acteurs de l’emploi, de la formation et du territoire.',
    icone: `<path stroke-linecap="round" stroke-linejoin="round" d="M4 8.5h13m0 0-4-4m4 4-4 4" /><path stroke-linecap="round" stroke-linejoin="round" d="M20 15.5H7m0 0 4 4m-4-4 4-4" />`,
  },
];

const mentionGold =
  'Les offres sont validées par LabEvents. Les annonces similaires peuvent être regroupées afin de préserver la lisibilité du parcours candidat.';

const formules = [
  {
    valeur: 'standard',
    nom: 'Standard',
    items: [
      'Emplacement d’exposition équipé pendant les deux journées',
      'Panneaux de séparation',
      'Une table et quatre chaises',
      'Fiche essentielle dans l’annuaire des exposants',
      'Logo et lien vers le site de l’exposant',
      'Déclaration et publication de 5 offres maximum',
      'Réception, après le salon, des candidatures adressées à vos offres',
    ],
  },
  {
    valeur: 'silver',
    nom: 'Silver',
    sousTitre: 'Exposant partenaire',
    disponibilite: '4 formules maximum sur l’ensemble du salon',
    intro: 'Comprend les prestations Standard, plus :',
    items: [
      'Fiche exposant enrichie',
      'Présentation de l’activité',
      'Publicité en bandeau sur le site avec rotation standard',
      'Logo sur l’affiche et le visuel master',
      'Présence sur les supports numériques',
      'Une publication dédiée sur les réseaux sociaux',
      'Un créneau de 30 minutes dans l’espace ateliers-conférences',
      'Déclaration et publication de 10 offres maximum',
      'Accès aux profils candidats compatibles inclus',
    ],
  },
  {
    valeur: 'gold',
    nom: 'Gold',
    sousTitre: 'Partenaire premium',
    disponibilite: '2 formules maximum sur l’ensemble du salon',
    intro: 'Comprend les prestations Silver, avec une visibilité renforcée :',
    items: [
      'Vitrine premium sur le site',
      'Présentation développée de l’activité',
      'Galerie de photographies',
      'Publicité en bandeau avec rotation renforcée et prioritaire',
      'Présence sur l’ensemble des supports de communication',
      'Deux publications dédiées et des stories',
      'Deux créneaux dans l’espace ateliers-conférences, dont un prioritaire',
      'Mentions par l’animateur pendant le salon',
      'Déclaration et publication des offres sans plafond prédéfini',
      'Accès aux profils candidats compatibles inclus',
    ],
    mention: mentionGold,
    miseEnAvant: true,
  },
];

const comparatif = [
  { critere: 'Formules disponibles', standard: '—', silver: '4 maximum', gold: '2 maximum' },
  { critere: 'Offres publiées', standard: '5 maximum', silver: '10 maximum', gold: 'Sans plafond prédéfini' },
  { critere: 'Accès profils compatibles', standard: 'Option sur demande', silver: 'Inclus', gold: 'Inclus' },
  { critere: 'Créneau ateliers-conférences', standard: '—', silver: '30 minutes', gold: '2 créneaux, dont 1 prioritaire' },
  { critere: 'Visibilité digitale', standard: 'Fiche essentielle', silver: 'Fiche enrichie + bandeau standard', gold: 'Vitrine premium + bandeau prioritaire' },
];

const parcoursCandidature = [
  {
    numero: '1',
    titre: 'Vous déclarez vos offres',
    texte: 'Via un formulaire dédié, dans la limite prévue par votre formule.',
  },
  {
    numero: '2',
    titre: 'Les candidats postulent',
    texte:
      'Ils sélectionnent jusqu’à cinq offres, renseignent leur profil, déposent leur CV et rédigent un texte personnel de valorisation.',
  },
  {
    numero: '3',
    titre: 'Vous recevez les candidatures',
    texte: 'Après la clôture du salon, LabEvents vous transmet les candidatures adressées à vos offres.',
  },
];

const contenuDossier = [
  'Les informations professionnelles renseignées',
  'Le CV',
  'Le projet du candidat',
  'Son texte personnel de valorisation',
  'La référence de l’offre sélectionnée',
];

const repartitionProfils = [
  { formule: 'Standard', valeur: 'Option sur demande' },
  { formule: 'Silver', valeur: 'Inclus' },
  { formule: 'Gold', valeur: 'Inclus' },
];

const equipementEmplacement = [
  'Deux éléments de séparation de 1,22 m de largeur, soit une largeur totale de 2,44 m',
  'Hauteur des panneaux : 2 m',
  'Une table',
  'Quatre chaises',
  'Mise à disposition pendant les deux journées',
  'Accompagnement LabEvents avant et pendant le salon',
];

const optionsComplementaires = [
  {
    nom: 'Affiche de stand',
    items: [
      'Format 110 × 145 cm',
      'Impression comprise',
      'Fichier prêt à imprimer fourni par l’exposant',
      'PAO non comprise',
    ],
  },
  {
    nom: 'Barnum extérieur',
    items: ['Format 3 × 3 m', 'Sous réserve de disponibilité', 'Sous réserve de validation de l’activité et des contraintes techniques'],
  },
  {
    nom: 'Partenaire de l’espace ateliers-conférences',
    disponibilite: 'Partenariat unique — une seule formule disponible sur l’ensemble du salon.',
    description: 'Associez votre marque à l’ensemble de la programmation de l’espace ateliers-conférences.',
    typeDemande: 'ateliers-conferences',
  },
];

const typesDemande = [
  { valeur: 'exposer', label: 'Exposer' },
  { valeur: 'partenaire', label: 'Devenir partenaire' },
  { valeur: 'ateliers-conferences', label: 'Partenaire espace ateliers-conférences' },
  { valeur: 'information', label: 'Recevoir des informations' },
];

const typesStructure = [
  { valeur: 'entreprise', label: 'Entreprise' },
  { valeur: 'organisme-formation', label: 'Organisme de formation' },
  { valeur: 'institution', label: 'Institution' },
  { valeur: 'accompagnement', label: 'Structure d’accompagnement' },
  { valeur: 'association', label: 'Association' },
  { valeur: 'autre', label: 'Autre' },
];

const objetsVisiteur = [
  { valeur: 'informations-pratiques', label: 'Informations pratiques' },
  { valeur: 'programme', label: 'Programme' },
  { valeur: 'accueil-scolaire', label: 'Accueil scolaire' },
  { valeur: 'accessibilite', label: 'Accessibilité' },
  { valeur: 'autre', label: 'Autre' },
];

const champIcon = `<path stroke-linecap="round" stroke-linejoin="round" d="M7 3.5h7l4 4v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1v-16a1 1 0 0 1 1-1Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M14 3.5V8h4" />`;
const checkIcon = `<path stroke-linecap="round" stroke-linejoin="round" d="m5 12 5 5 9-9" />`;

const inputClass =
  'mt-1.5 w-full rounded-md border border-marine/20 bg-blanc px-3.5 py-2.5 text-sm text-encre placeholder:text-encre/40 focus:border-village focus:outline-none focus:ring-2 focus:ring-village/30';
const labelClass = 'block text-sm font-semibold text-marine';
---

<BaseLayout
  title="Exposer et devenir partenaire"
  description="Découvrez l'offre exposants 2026 du Salon de l'Emploi & de la Formation à Nouméa : formules Standard, Silver et Gold, dispositif de candidatures et options complémentaires."
>
  <!-- ============================== HERO ============================== -->
  <section class="bg-marine text-blanc">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-20">
      <p class="text-xs font-bold uppercase tracking-widest text-orange">Exposer au salon</p>
      <h1 class="mt-3 max-w-3xl font-titre text-4xl font-bold uppercase leading-none sm:text-5xl xl:text-6xl">
        Exposez, recrutez et développez votre visibilité
      </h1>
      <p class="mt-6 max-w-2xl font-titre text-xl font-bold uppercase text-orange sm:text-2xl">
        Rencontrez vos futurs collaborateurs. Faites découvrir vos métiers. Créez des contacts
        utiles.
      </p>

      <ul class="mt-8 grid grid-cols-2 gap-x-6 gap-y-3 text-sm font-semibold uppercase tracking-wide text-brume sm:flex sm:flex-wrap sm:gap-x-8">
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-orange" aria-hidden="true"></span>
          Salle d'exposition de Nouville — Nouméa
        </li>
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-orange" aria-hidden="true"></span>
          30 et 31 octobre 2026
        </li>
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-orange" aria-hidden="true"></span>
          9 h à 17 h
        </li>
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-orange" aria-hidden="true"></span>
          Entrée visiteurs libre et gratuite
        </li>
      </ul>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href="#demande-exposant"
          class="inline-flex items-center justify-center rounded-md bg-village px-6 py-3.5 font-titre text-lg font-bold uppercase tracking-wide text-marine transition-opacity hover:opacity-90"
        >
          Réserver mon emplacement
        </a>
        <a
          href={packCommercial.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-md border-2 border-blanc px-6 py-3.5 font-titre text-lg font-bold uppercase tracking-wide text-blanc transition-colors hover:bg-blanc hover:text-marine"
        >
          Télécharger le dossier exposant
        </a>
      </div>
    </div>
  </section>

  <!-- ========================= CHIFFRES CLÉS ========================= -->
  <section class="border-b border-marine/10 bg-brume" aria-labelledby="chiffres-titre">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <h2 id="chiffres-titre" class="sr-only">Le salon en chiffres</h2>

      <ul class="grid grid-cols-2 gap-px bg-marine/10 sm:grid-cols-3 lg:grid-cols-5">
        {
          chiffresCles.map((chiffre) => (
            <li class="flex flex-col items-center bg-brume px-4 py-8 text-center">
              <span class="block font-titre text-4xl font-bold leading-none text-marine sm:text-5xl">
                {chiffre.value}
              </span>
              <span class="mt-2 block font-titre text-base font-bold uppercase leading-none tracking-wide text-marine">
                {chiffre.unite}
              </span>
              <span class="mt-1 block text-sm text-encre">{chiffre.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===================== TROIS RAISONS D'EXPOSER ===================== -->
  <section class="bg-blanc">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
      <h2 class="text-center font-titre text-3xl font-bold uppercase text-marine sm:text-4xl">
        Pourquoi exposer ?
      </h2>

      <div class="mt-10 grid gap-px bg-marine/10 sm:grid-cols-3">
        {
          raisons.map((raison) => (
            <article class="flex flex-col items-center bg-blanc px-5 py-8 text-center">
              <svg
                class="h-10 w-10 text-orange"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
                set:html={raison.icone}
              />
              <h3 class="mt-4 font-titre text-xl font-bold uppercase leading-none text-marine">
                {raison.verbe}
              </h3>
              <p class="mt-1 font-titre text-base font-semibold text-marine">{raison.complement}</p>
              <p class="mt-3 text-sm leading-relaxed text-encre">{raison.texte}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================== NOS FORMULES ========================= -->
  <section class="border-t border-marine/10 bg-brume">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
      <h2 class="text-center font-titre text-3xl font-bold uppercase text-marine sm:text-4xl">
        Choisissez votre formule
      </h2>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          formules.map((formule) => (
            <article
              class:list={[
                'flex flex-col rounded-2xl border bg-blanc p-6',
                formule.miseEnAvant ? 'border-2 border-village' : 'border-marine/15',
              ]}
            >
              <h3 class="font-titre text-2xl font-bold uppercase leading-tight text-marine">{formule.nom}</h3>
              {formule.sousTitre && <p class="mt-1 text-sm font-semibold text-encre/70">{formule.sousTitre}</p>}
              {formule.disponibilite && (
                <p class="mt-1 text-xs font-bold uppercase tracking-wide text-orange-dark">{formule.disponibilite}</p>
              )}
              <div class="mt-3 h-1 w-10 rounded-full bg-village" aria-hidden="true" />

              {formule.intro && <p class="mt-4 text-sm font-semibold text-marine">{formule.intro}</p>}
              <ul class="mt-3 flex-1 space-y-2.5 text-sm text-encre">
                {formule.items.map((item) => (
                  <li class="flex items-start gap-2">
                    <svg
                      class="mt-0.5 h-4 w-4 flex-shrink-0 text-village"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                      set:html={checkIcon}
                    />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              {formule.mention && (
                <p class="mt-4 text-xs leading-relaxed text-encre/70">{formule.mention}</p>
              )}

              <a
                href="#demande-exposant"
                data-preselect-formule={formule.valeur}
                class="mt-5 inline-flex items-center justify-center rounded-md bg-village px-5 py-2.5 font-titre text-base font-bold uppercase tracking-wide text-marine transition-opacity hover:opacity-90"
              >
                Demander cette formule
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== TABLEAU COMPARATIF ===================== -->
  <section class="bg-blanc">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
      <h2 class="text-center font-titre text-3xl font-bold uppercase text-marine sm:text-4xl">
        Comparer les formules en un coup d'œil
      </h2>

      <div
        class="mt-10 overflow-x-auto rounded-2xl border border-marine/15"
        tabindex="0"
        role="region"
        aria-label="Comparatif des formules Standard, Silver et Gold — défilement horizontal"
      >
        <table class="w-full min-w-[640px] border-collapse text-left text-sm">
          <caption class="sr-only">Comparatif des formules Standard, Silver et Gold</caption>
          <thead>
            <tr class="bg-marine text-blanc">
              <th scope="col" class="px-4 py-3 font-titre text-sm font-bold uppercase tracking-wide">
                Critère
              </th>
              <th scope="col" class="px-4 py-3 font-titre text-sm font-bold uppercase tracking-wide">
                Standard
              </th>
              <th scope="col" class="px-4 py-3 font-titre text-sm font-bold uppercase tracking-wide">
                Silver
              </th>
              <th scope="col" class="px-4 py-3 font-titre text-sm font-bold uppercase tracking-wide">
                Gold
              </th>
            </tr>
          </thead>
          <tbody>
            {
              comparatif.map((ligne, i) => (
                <tr class:list={[i % 2 === 0 ? 'bg-blanc' : 'bg-brume']}>
                  <th scope="row" class="px-4 py-3 font-semibold text-marine">{ligne.critere}</th>
                  <td class="px-4 py-3 text-encre">{ligne.standard}</td>
                  <td class="px-4 py-3 text-encre">{ligne.silver}</td>
                  <td class="px-4 py-3 text-encre">{ligne.gold}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs text-encre/70">
        Détail complet des prestations dans les formules ci-dessus. Contactez-nous pour recevoir
        une proposition adaptée à votre participation.
      </p>
    </div>
  </section>

  <!-- =================== DISPOSITIF DE CANDIDATURES =================== -->
  <section class="border-t border-marine/10 bg-village text-marine">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
      <p class="text-xs font-bold uppercase tracking-widest text-marine">Recrutement</p>
      <h2 class="mt-2 font-titre text-3xl font-bold uppercase leading-tight sm:text-4xl">
        Votre recrutement commence avant le salon
      </h2>
      <p class="mt-5 max-w-3xl text-sm sm:text-base">
        Il n'existe pas de plateforme ni d'accès autonome à une base de CV : le dispositif repose
        sur la déclaration de vos offres et la transmission, après le salon, des candidatures qui
        leur sont directement adressées.
      </p>

      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          parcoursCandidature.map((etape) => (
            <div class="rounded-2xl bg-blanc/90 p-6">
              <span class="font-titre text-4xl font-bold leading-none text-village-dark">{etape.numero}</span>
              <h3 class="mt-3 font-titre text-lg font-bold uppercase leading-none text-marine">{etape.titre}</h3>
              <p class="mt-3 text-sm leading-relaxed text-encre">{etape.texte}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-8 rounded-2xl bg-blanc/90 p-6 sm:p-8">
        <h3 class="font-titre text-lg font-bold uppercase text-marine">Chaque dossier comprend</h3>
        <ul class="mt-3 grid gap-2.5 text-sm text-encre sm:grid-cols-2">
          {
            contenuDossier.map((item) => (
              <li class="flex items-start gap-2">
                <svg
                  class="mt-0.5 h-4 w-4 flex-shrink-0 text-village-dark"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                  set:html={checkIcon}
                />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <p class="mt-8 text-sm text-encre">
        Une fois validées par LabEvents, vos offres sont publiées sur
        {' '}
        <a href="/offres" class="font-semibold text-marine underline underline-offset-2 hover:text-village-dark">
          la page des offres du salon
        </a>
        , où les candidats peuvent les consulter et les sélectionner avant le salon.
      </p>

      <div class="mt-8 rounded-2xl border-2 border-marine/20 bg-blanc/90 p-6 sm:p-8">
        <h3 class="font-titre text-lg font-bold uppercase text-marine">Accès aux profils candidats compatibles</h3>
        <p class="mt-3 text-sm text-encre sm:text-base">
          Selon la formule choisie, LabEvents peut également identifier, parmi les candidats ayant
          donné leur accord, des profils correspondant aux métiers et aux principaux critères de
          recrutement de l'exposant.
        </p>
        <ul class="mt-4 grid gap-3 sm:grid-cols-3">
          {
            repartitionProfils.map((ligne) => (
              <li class="rounded-xl border border-marine/15 bg-brume px-4 py-3 text-center">
                <p class="text-xs font-bold uppercase tracking-wide text-marine/70">{ligne.formule}</p>
                <p class="mt-1 font-titre text-base font-bold text-marine">{ligne.valeur}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <p class="mt-6 max-w-3xl text-xs leading-relaxed text-marine">
        Les candidatures nominatives sont transmises après la clôture du salon afin de préserver
        la rencontre physique pendant l'événement. Le nombre de candidatures reçues et leur
        adéquation avec les besoins de l'exposant ne peuvent être garantis par LabEvents.
      </p>
    </div>
  </section>

  <!-- =================== ÉQUIPEMENT DE L'EMPLACEMENT =================== -->
  <section class="bg-blanc">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
      <h2 class="text-center font-titre text-3xl font-bold uppercase text-marine sm:text-4xl">
        Équipement de l'emplacement
      </h2>
      <p class="mx-auto mt-5 max-w-3xl text-center text-encre">
        Les emplacements proposés correspondent aux espaces natifs de la Salle d'exposition de
        Nouville. Leur surface et leur configuration varient selon leur localisation.
      </p>

      <ul class="mx-auto mt-10 grid max-w-4xl gap-4 sm:grid-cols-2">
        {
          equipementEmplacement.map((item) => (
            <li class="flex items-center gap-3 rounded-xl border border-marine/15 bg-brume px-5 py-4 text-sm font-semibold text-marine sm:text-base">
              <span class="h-2 w-2 flex-shrink-0 rounded-full bg-village" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>

