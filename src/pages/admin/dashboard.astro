---
import { getCollection } from 'astro:content';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { estOffreTest } from '../../lib/offres';
import { formuleLabels } from '../../lib/exposants';
import { repartitionPar, repartitionParMultiple } from '../../lib/admin';
import { statutVisibilite } from '../../lib/visibilites';

/*
  Tableau de bord Admin-1 (voir CLAUDE.md section 14). Tous les indicateurs
  sont calculés dynamiquement depuis les Content Collections `exposants` et
  `offres` — aucun chiffre codé en dur.

  Répartition par « formule » exposant (Lot Admin-1B, docs/EXPOSANTS_IMPORT.md) :
  calculée à partir de `exposant.data.formule` uniquement, jamais déduite des
  offres. Seules les formules réellement représentées apparaissent
  (`repartitionPar` ne fabrique pas de catégorie vide).

  Offres TEST (voir docs/OFFRES.md, src/lib/offres.ts::estOffreTest) :
  exclues des KPI métier (total opérationnel, répartitions) — ce sont des
  fiches de démonstration, pas de vraies offres exposant. Réutilise le seul
  mécanisme de détection existant sur le site (préfixe `TEST —` sur
  `intitule`), déjà utilisé par la fiche publique et OffreCard — pas de
  seconde règle indépendante.
*/

const exposants = await getCollection('exposants');
const toutesLesOffres = await getCollection('offres');

const offresReelles = toutesLesOffres.filter((o) => !estOffreTest(o));
const offresTest = toutesLesOffres.filter((o) => estOffreTest(o));

const totalExposants = exposants.length;
const exposantsPublies = exposants.filter((e) => e.data.publie).length;

const repartitionFormule = repartitionPar(exposants, (e) => formuleLabels[e.data.formule]);

const totalOffresReelles = offresReelles.length;
const offresReellesPubliees = offresReelles.filter((o) => o.data.status === 'publiee').length;

/*
  Répartition par exposant : basée sur `exposantNom`, un champ réellement
  présent et renseigné sur chaque offre (contrairement au rattachement par
  `exposantId`, qui suppose que la fiche exposant correspondante existe déjà
  dans la collection `exposants` — pas encore le cas en pratique, voir
  docs/ADMIN.md). Calculée uniquement sur les offres réelles (hors TEST).
*/
const repartitionExposants = repartitionPar(offresReelles, (o) => o.data.exposantNom);
const repartitionTypeContrat = repartitionParMultiple(offresReelles, (o) => o.data.typeContrat);

/*
  Résumé Visibilité (Lot Admin-2, voir docs/VISIBILITE.md) : uniquement des
  compteurs par statut calculé, pas de détail — le détail vit sur
  /admin/visibilite. Volontairement léger (CLAUDE.md, cadrage Admin-2 § 10).
*/
const toutesLesVisibilites = await getCollection('visibilites');
const maintenant = new Date();
const visibilitesActives = toutesLesVisibilites.filter((v) => statutVisibilite(v, maintenant) === 'actif').length;
const visibilitesAVenir = toutesLesVisibilites.filter((v) => statutVisibilite(v, maintenant) === 'a-venir').length;
---

<AdminLayout title="Tableau de bord" section="dashboard">
  <h1 class="text-2xl font-bold text-marine">Tableau de bord</h1>
  <p class="mt-2 max-w-prose text-sm text-encre/80">
    Indicateurs calculés à partir des Content Collections du site. Lecture seule — aucune donnée n'est modifiable
    depuis cet espace.
  </p>

  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-2xl border border-marine/15 bg-blanc p-5">
      <p class="text-xs font-bold uppercase tracking-wide text-marine/70">Exposants — total</p>
      <p class="mt-2 font-titre text-3xl font-bold text-marine">{totalExposants}</p>
    </div>
    <div class="rounded-2xl border border-marine/15 bg-blanc p-5">
      <p class="text-xs font-bold uppercase tracking-wide text-marine/70">Exposants — publiés</p>
      <p class="mt-2 font-titre text-3xl font-bold text-marine">{exposantsPublies}</p>
    </div>
    <div class="rounded-2xl border border-marine/15 bg-blanc p-5">
      <p class="text-xs font-bold uppercase tracking-wide text-marine/70">Offres réelles — total</p>
      <p class="mt-2 font-titre text-3xl font-bold text-marine">{totalOffresReelles}</p>
    </div>
    <div class="rounded-2xl border border-marine/15 bg-blanc p-5">
      <p class="text-xs font-bold uppercase tracking-wide text-marine/70">Offres réelles — publiées</p>
      <p class="mt-2 font-titre text-3xl font-bold text-marine">{offresReellesPubliees}</p>
    </div>
    <div class="rounded-2xl border border-marine/15 bg-blanc p-5">
      <p class="text-xs font-bold uppercase tracking-wide text-marine/70">Visibilité — campagnes actives</p>
      <p class="mt-2 font-titre text-3xl font-bold text-marine">{visibilitesActives}</p>
      {visibilitesAVenir > 0 && (
        <p class="mt-1 text-xs text-encre/60">+ {visibilitesAVenir} à venir</p>
      )}
      <a href="/admin/visibilite" class="mt-2 inline-block text-xs font-semibold text-marine underline">
        Voir la visibilité
      </a>
    </div>
  </div>

  {
    offresTest.length > 0 && (
      <p class="mt-4 w-fit rounded-full bg-marine/10 px-3 py-1.5 text-xs font-semibold text-marine/80">
        + {offresTest.length} {offresTest.length > 1 ? 'offres TEST' : 'offre TEST'} de démonstration (exclues des
        indicateurs ci-dessus)
      </p>
    )
  }

  <div class="mt-10 grid gap-6 lg:grid-cols-2">
    <div class="rounded-2xl border border-marine/15 bg-blanc p-5">
      <h2 class="font-titre text-lg font-bold uppercase text-marine">Exposants par formule</h2>
      <p class="mt-1 text-xs text-encre/70">Formule commerciale déclarée sur la fiche exposant.</p>
      {
        repartitionFormule.length > 0 ? (
          <ul class="mt-4 space-y-2 text-sm">
            {repartitionFormule.map((ligne) => (
              <li class="flex items-center justify-between gap-3 border-b border-marine/10 pb-2">
                <span class="text-encre">{ligne.valeur}</span>
                <span class="font-titre font-bold text-marine">{ligne.total}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-4 text-sm text-encre/70">Aucun exposant à afficher.</p>
        )
      }
    </div>

    <div class="rounded-2xl border border-marine/15 bg-blanc p-5">
      <h2 class="font-titre text-lg font-bold uppercase text-marine">Offres par exposant</h2>
      <p class="mt-1 text-xs text-encre/70">Regroupement par nom d'exposant déclaré sur chaque offre.</p>
      {
        repartitionExposants.length > 0 ? (
          <ul class="mt-4 space-y-2 text-sm">
            {repartitionExposants.map((ligne) => (
              <li class="flex items-center justify-between gap-3 border-b border-marine/10 pb-2">
                <span class="text-encre">{ligne.valeur}</span>
                <span class="font-titre font-bold text-marine">{ligne.total}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-4 text-sm text-encre/70">Aucune offre réelle à afficher.</p>
        )
      }
    </div>

    <div class="rounded-2xl border border-marine/15 bg-blanc p-5">
      <h2 class="font-titre text-lg font-bold uppercase text-marine">Offres par type de contrat</h2>
      {
        repartitionTypeContrat.length > 0 ? (
          <ul class="mt-4 space-y-2 text-sm">
            {repartitionTypeContrat.map((ligne) => (
              <li class="flex items-center justify-between gap-3 border-b border-marine/10 pb-2">
                <span class="text-encre">{ligne.valeur}</span>
                <span class="font-titre font-bold text-marine">{ligne.total}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-4 text-sm text-encre/70">Aucune offre réelle à afficher.</p>
        )
      }
    </div>
  </div>

  <div class="mt-10 flex flex-col gap-3 sm:flex-row">
    <a
      href="/admin/exposants"
      class="inline-flex items-center justify-center rounded-md bg-marine px-6 py-3 font-titre text-base font-bold uppercase tracking-wide text-blanc transition-opacity hover:opacity-90"
    >
      Voir les exposants
    </a>
    <a
      href="/admin/offres"
      class="inline-flex items-center justify-center rounded-md border-2 border-marine px-6 py-3 font-titre text-base font-bold uppercase tracking-wide text-marine transition-colors hover:bg-marine hover:text-blanc"
    >
      Voir les offres
    </a>
  </div>
</AdminLayout>
