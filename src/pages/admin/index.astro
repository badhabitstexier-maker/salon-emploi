---
import AdminLayout from '../../layouts/AdminLayout.astro';

/*
  Lot Admin-0 : socle technique uniquement (voir docs/ADMIN.md). Aucune
  fonction métier ici — le tableau de bord, les listes exposants/offres et
  le module « visibilité » sont hors périmètre de ce lot.
*/
---

<AdminLayout title="Accueil">
  <h1 class="text-2xl font-bold text-marine">Espace Admin LabEvents</h1>
  <p class="mt-4 max-w-prose text-encre">
    Socle technique de l'espace d'administration interne. Aucune fonctionnalité métier n'est encore disponible à ce
    stade (voir <code>docs/ADMIN.md</code> pour l'état d'avancement et les prochains lots).
  </p>
</AdminLayout>
