---
import { getCollection } from 'astro:content';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  typeAnnonceurLabels,
  formatLabels,
  pageLabels,
  statutLabels,
} from '../../../lib/visibilites';

/*
  Vue Admin Visibilité — CRUD complet (Admin-2B, voir docs/VISIBILITE.md).

  CHANGEMENT Admin-2B : jusqu'au Lot Admin-2, cette page lisait
  `getCollection('visibilites')` au build (lecture seule, une campagne =
  un fichier Markdown). Depuis Admin-2B, les campagnes vivent dans
  visibilites.json sur le serveur, gérées par /admin-api/visibilites.php —
  Astro n'a plus aucune connaissance de ces données au build. Cette page ne
  rend donc plus aucune ligne côté serveur : le tableau est entièrement
  rempli par le contrôleur client (src/lib/admin-visibilite-ui.ts), qui
  appelle l'API Admin au chargement. Seule la liste des exposants (restée
  une Content Collection, inchangée par Admin-2B) est encore résolue au
  build, pour permettre le lien « Voir la fiche exposant » sans appel
  réseau supplémentaire.
*/

const exposants = await getCollection('exposants');
const exposantsParId = exposants.map((exposant) => ({
  exposantId: exposant.data.exposantId,
  nom: exposant.data.nom,
  slug: exposant.id,
}));
---

<AdminLayout title="Visibilité" section="visibilite">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-marine">Visibilité</h1>
      <p class="mt-2 max-w-prose text-sm text-encre/80">
        Campagnes de visibilité publicitaire (bandeaux) programmées sur le site public. Distinct de la formule
        commerciale exposant : voir la note en bas de page.
      </p>
    </div>
    <a
      href="/admin/visibilite/formulaire"
      class="inline-flex shrink-0 items-center justify-center rounded-md bg-marine px-5 py-2.5 font-titre text-sm font-bold uppercase tracking-wide text-blanc transition-opacity hover:opacity-90"
    >
      + Nouvelle visibilité
    </a>
  </div>

  <p id="visibilite-erreur-chargement" class="mt-6 hidden rounded-2xl border border-orange/40 bg-orange/10 p-5 text-sm text-marine" role="alert">
    Impossible de charger les campagnes (API indisponible). <button type="button" id="visibilite-reessayer" class="font-semibold underline">Réessayer</button>
  </p>

  <p id="visibilite-chargement" class="mt-6 text-sm text-encre/70">Chargement des campagnes…</p>

  <div id="visibilite-contenu" class="hidden">
    <form id="filtres-visibilite-admin" class="mt-6 rounded-2xl border border-marine/15 bg-blanc p-5 sm:p-6">
      <div class="grid gap-4 sm:grid-cols-3">
        <div>
          <label for="filtre-statut-admin" class="block text-xs font-bold uppercase tracking-wide text-marine">Statut</label>
          <select id="filtre-statut-admin" name="statut" class="mt-1.5 w-full rounded-md border border-marine/20 bg-brume px-3 py-2.5 text-sm text-encre focus:border-marine focus:outline-none focus:ring-2 focus:ring-marine/30">
            <option value="">Tous</option>
            <option value="actif">{statutLabels.actif}</option>
            <option value="a-venir">{statutLabels['a-venir']}</option>
            <option value="expire">{statutLabels.expire}</option>
            <option value="desactive">{statutLabels.desactive}</option>
          </select>
        </div>
        <div>
          <label for="filtre-type-admin" class="block text-xs font-bold uppercase tracking-wide text-marine">Type d'annonceur</label>
          <select id="filtre-type-admin" name="type" class="mt-1.5 w-full rounded-md border border-marine/20 bg-brume px-3 py-2.5 text-sm text-encre focus:border-marine focus:outline-none focus:ring-2 focus:ring-marine/30">
            <option value="">Tous</option>
            {Object.entries(typeAnnonceurLabels).map(([valeur, label]) => <option value={valeur}>{label}</option>)}
          </select>
        </div>
        <div>
          <label for="filtre-page-admin" class="block text-xs font-bold uppercase tracking-wide text-marine">Page</label>
          <select id="filtre-page-admin" name="page" class="mt-1.5 w-full rounded-md border border-marine/20 bg-brume px-3 py-2.5 text-sm text-encre focus:border-marine focus:outline-none focus:ring-2 focus:ring-marine/30">
            <option value="">Toutes</option>
            {Object.entries(pageLabels).map(([valeur, label]) => <option value={valeur}>{label}</option>)}
          </select>
        </div>
      </div>
      <p id="resultats-compte-visibilite-admin" class="mt-4 text-sm font-semibold text-marine" aria-live="polite"></p>
    </form>

    <div class="mt-6 overflow-x-auto rounded-2xl border border-marine/15 bg-blanc">
      <table class="w-full min-w-[960px] text-left text-sm">
        <thead class="border-b border-marine/15 bg-brume text-xs font-bold uppercase tracking-wide text-marine">
          <tr>
            <th scope="col" class="px-4 py-3">Aperçu</th>
            <th scope="col" class="px-4 py-3">Annonceur</th>
            <th scope="col" class="px-4 py-3">Type</th>
            <th scope="col" class="px-4 py-3">Page / emplacement</th>
            <th scope="col" class="px-4 py-3">Période</th>
            <th scope="col" class="px-4 py-3">Poids</th>
            <th scope="col" class="px-4 py-3">Statut</th>
            <th scope="col" class="px-4 py-3">Actions</th>
          </tr>
        </thead>
        <tbody id="corps-visibilite-admin"></tbody>
      </table>
    </div>

    <p id="visibilite-liste-vide" class="mt-6 hidden rounded-2xl border border-marine/15 bg-blanc p-8 text-center text-sm text-encre">
      Aucune campagne de visibilité programmée à ce jour.
    </p>
    <p id="aucun-resultat-visibilite-admin" class="mt-6 hidden rounded-2xl border border-marine/15 bg-blanc p-8 text-center text-sm text-encre">
      Aucune campagne ne correspond à ces filtres.
    </p>
  </div>

  <p class="mt-10 max-w-prose text-xs text-encre/60">
    Le poids de diffusion est saisi librement par LabEvents, indépendamment de la formule commerciale
    (standard/silver/gold) de l'exposant éventuellement rattaché — voir docs/VISIBILITE.md, section 1.
  </p>

  <script type="application/json" id="visibilite-exposants-donnees" set:html={JSON.stringify(exposantsParId)} />
</AdminLayout>

<script>
  import { calculerStatut, statutLabels, statutBadgeClasses, typeAnnonceurLabels, formatLabels, pageLabels } from '../../../lib/visibilites';
  import { chargerListeEtSession, basculerActif, supprimerVisibilite, type SessionAdmin } from '../../../lib/admin-visibilite-ui';
  import type { Visibilite } from '../../../lib/visibilites';

  const formateurDate = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'medium' });

  function periodeTexte(dateDebut?: string, dateFin?: string): string {
    if (!dateDebut && !dateFin) return 'Permanente';
    if (dateDebut && dateFin) return `Du ${formateurDate.format(new Date(dateDebut))} au ${formateurDate.format(new Date(dateFin))}`;
    if (dateDebut) return `À partir du ${formateurDate.format(new Date(dateDebut))}`;
    return `Jusqu'au ${formateurDate.format(new Date(dateFin as string))}`;
  }

  interface ExposantResume {
    exposantId?: string;
    nom: string;
    slug: string;
  }

  function lireExposants(): ExposantResume[] {
    const script = document.getElementById('visibilite-exposants-donnees');
    if (!script?.textContent) return [];
    try {
      return JSON.parse(script.textContent);
    } catch {
      return [];
    }
  }

  const elChargement = document.getElementById('visibilite-chargement');
  const elErreur = document.getElementById('visibilite-erreur-chargement');
  const elContenu = document.getElementById('visibilite-contenu');
  const elListeVide = document.getElementById('visibilite-liste-vide');
  const elAucunResultat = document.getElementById('aucun-resultat-visibilite-admin');
  const corps = document.getElementById('corps-visibilite-admin');
  const form = document.getElementById('filtres-visibilite-admin') as HTMLFormElement | null;
  const compte = document.getElementById('resultats-compte-visibilite-admin');
  const boutonReessayer = document.getElementById('visibilite-reessayer');

  const exposants = lireExposants();
  let session: SessionAdmin | null = null;

  function exposantParId(exposantId: string | undefined | null): ExposantResume | undefined {
    if (!exposantId) return undefined;
    return exposants.find((e) => e.exposantId === exposantId);
  }

  function construireLigne(visibilite: Visibilite): HTMLTableRowElement {
    const statut = calculerStatut(visibilite.actif, visibilite.dateDebut ? new Date(visibilite.dateDebut) : undefined, visibilite.dateFin ? new Date(visibilite.dateFin) : undefined, new Date());
    const exposant = exposantParId(visibilite.exposantId);

    const tr = document.createElement('tr');
    tr.dataset.visibiliteRow = '1';
    tr.dataset.statut = statut;
    tr.dataset.type = visibilite.typeAnnonceur;
    tr.dataset.pages = visibilite.pages.join(' ');
    tr.className = 'border-b border-marine/10 last:border-0 align-top hover:bg-brume/60';

    const tdApercu = document.createElement('td');
    tdApercu.className = 'px-4 py-3';
    const img = document.createElement('img');
    img.src = visibilite.visuel;
    img.alt = '';
    img.loading = 'lazy';
    img.className = 'h-10 w-24 rounded object-cover';
    tdApercu.appendChild(img);
    const pMobile = document.createElement('p');
    pMobile.className = 'mt-1 text-[11px] text-encre/60';
    pMobile.textContent = visibilite.visuelMobile ? 'Visuel mobile dédié' : 'Mobile : repli desktop';
    tdApercu.appendChild(pMobile);
    tr.appendChild(tdApercu);

    const tdAnnonceur = document.createElement('td');
    tdAnnonceur.className = 'px-4 py-3 font-semibold text-marine';
    tdAnnonceur.append(visibilite.annonceur);
    const pNomInterne = document.createElement('p');
    pNomInterne.className = 'mt-0.5 text-xs font-normal text-encre/60';
    pNomInterne.textContent = visibilite.nomInterne;
    tdAnnonceur.appendChild(pNomInterne);
    if (exposant) {
      const lien = document.createElement('a');
      lien.href = `/admin/exposants/${exposant.slug}`;
      lien.className = 'mt-1 inline-block text-xs text-marine underline';
      lien.textContent = `Voir la fiche exposant (${exposant.nom})`;
      tdAnnonceur.appendChild(document.createElement('br'));
      tdAnnonceur.appendChild(lien);
    }
    tr.appendChild(tdAnnonceur);

    const tdType = document.createElement('td');
    tdType.className = 'px-4 py-3 text-encre';
    tdType.textContent = typeAnnonceurLabels[visibilite.typeAnnonceur];
    tr.appendChild(tdType);

    const tdPage = document.createElement('td');
    tdPage.className = 'px-4 py-3 text-encre';
    tdPage.textContent = visibilite.pages.map((p) => pageLabels[p]).join(', ');
    const spanEmplacement = document.createElement('span');
    spanEmplacement.className = 'block text-xs text-encre/60';
    spanEmplacement.textContent = `Emplacement : ${visibilite.emplacement} · ${formatLabels[visibilite.format]}`;
    tdPage.appendChild(spanEmplacement);
    tr.appendChild(tdPage);

    const tdPeriode = document.createElement('td');
    tdPeriode.className = 'px-4 py-3 text-encre';
    tdPeriode.textContent = periodeTexte(visibilite.dateDebut, visibilite.dateFin);
    tr.appendChild(tdPeriode);

    const tdPoids = document.createElement('td');
    tdPoids.className = 'px-4 py-3 font-titre font-bold text-marine';
    tdPoids.textContent = String(visibilite.poids);
    tr.appendChild(tdPoids);

    const tdStatut = document.createElement('td');
    tdStatut.className = 'px-4 py-3';
    const badge = document.createElement('span');
    badge.className = `rounded-full px-2.5 py-1 text-xs font-bold uppercase tracking-wide ${statutBadgeClasses[statut]}`;
    badge.textContent = statutLabels[statut];
    tdStatut.appendChild(badge);
    tr.appendChild(tdStatut);

    const tdActions = document.createElement('td');
    tdActions.className = 'px-4 py-3';
    const conteneurActions = document.createElement('div');
    conteneurActions.className = 'flex flex-wrap gap-2';

    const lienModifier = document.createElement('a');
    lienModifier.href = `/admin/visibilite/formulaire?id=${encodeURIComponent(visibilite.id)}`;
    lienModifier.className = 'rounded-md border border-marine/30 px-2.5 py-1 text-xs font-semibold text-marine hover:bg-marine/5';
    lienModifier.textContent = 'Modifier';
    conteneurActions.appendChild(lienModifier);

    const boutonBascule = document.createElement('button');
    boutonBascule.type = 'button';
    boutonBascule.className = 'rounded-md border border-marine/30 px-2.5 py-1 text-xs font-semibold text-marine hover:bg-marine/5';
    boutonBascule.textContent = visibilite.actif ? 'Désactiver' : 'Activer';
    boutonBascule.addEventListener('click', () => onBasculerActif(visibilite, boutonBascule));
    conteneurActions.appendChild(boutonBascule);

    const boutonSupprimer = document.createElement('button');
    boutonSupprimer.type = 'button';
    boutonSupprimer.className = 'rounded-md border border-orange/50 px-2.5 py-1 text-xs font-semibold text-orange hover:bg-orange/10';
    boutonSupprimer.textContent = 'Supprimer';
    boutonSupprimer.addEventListener('click', () => onSupprimer(visibilite, tr));
    conteneurActions.appendChild(boutonSupprimer);

    tdActions.appendChild(conteneurActions);
    tr.appendChild(tdActions);

    return tr;
  }

  async function onBasculerActif(visibilite: Visibilite, bouton: HTMLButtonElement): Promise<void> {
    if (!session) return;
    bouton.disabled = true;
    const resultat = await basculerActif(session, visibilite.id, !visibilite.actif);
    if (!resultat.ok) {
      window.alert(resultat.messageErreur ?? 'Échec de la mise à jour.');
      bouton.disabled = false;
      return;
    }
    await rafraichir();
  }

  async function onSupprimer(visibilite: Visibilite, ligne: HTMLTableRowElement): Promise<void> {
    if (!session) return;
    const confirme = window.confirm(`Supprimer définitivement la campagne « ${visibilite.annonceur} » ? Cette action est irréversible.`);
    if (!confirme) return;
    ligne.querySelectorAll('button').forEach((b) => (b as HTMLButtonElement).disabled = true);
    const resultat = await supprimerVisibilite(session, visibilite.id);
    if (!resultat.ok) {
      window.alert(resultat.messageErreur ?? 'Échec de la suppression.');
      ligne.querySelectorAll('button').forEach((b) => (b as HTMLButtonElement).disabled = false);
      return;
    }
    await rafraichir();
  }

  function appliquerFiltres(): void {
    if (!form || !corps || !compte || !elAucunResultat) return;
    const donnees = new FormData(form);
    const statut = String(donnees.get('statut') ?? '');
    const type = String(donnees.get('type') ?? '');
    const page = String(donnees.get('page') ?? '');

    const lignes = Array.from(corps.querySelectorAll<HTMLTableRowElement>('[data-visibilite-row]'));
    let visibles = 0;
    for (const ligne of lignes) {
      const pages = (ligne.dataset.pages ?? '').split(' ');
      const visible = (!statut || ligne.dataset.statut === statut) && (!type || ligne.dataset.type === type) && (!page || pages.includes(page));
      ligne.classList.toggle('hidden', !visible);
      if (visible) visibles += 1;
    }
    compte.textContent = `${visibles} ${visibles > 1 || visibles === 0 ? 'résultats' : 'résultat'}`;
    elAucunResultat.classList.toggle('hidden', visibles !== 0 || lignes.length === 0);
  }

  async function rafraichir(): Promise<void> {
    const resultat = await chargerListeEtSession();
    elChargement?.classList.add('hidden');

    if (!resultat) {
      elErreur?.classList.remove('hidden');
      elContenu?.classList.add('hidden');
      return;
    }

    elErreur?.classList.add('hidden');
    session = resultat.session;

    if (!corps) return;
    corps.replaceChildren();

    if (resultat.visibilites.length === 0) {
      elContenu?.classList.add('hidden');
      elListeVide?.classList.remove('hidden');
      return;
    }

    elListeVide?.classList.add('hidden');
    elContenu?.classList.remove('hidden');

    const triees = [...resultat.visibilites].sort((a, b) => a.annonceur.localeCompare(b.annonceur, 'fr'));
    for (const visibilite of triees) {
      corps.appendChild(construireLigne(visibilite));
    }
    appliquerFiltres();
  }

  form?.addEventListener('input', appliquerFiltres);
  form?.addEventListener('change', appliquerFiltres);
  boutonReessayer?.addEventListener('click', () => {
    elErreur?.classList.add('hidden');
    elChargement?.classList.remove('hidden');
    void rafraichir();
  });

  void rafraichir();
</script>
