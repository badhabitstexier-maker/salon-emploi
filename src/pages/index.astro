---
import BaseLayout from '../layouts/BaseLayout.astro';
import Visuel from '../components/Visuel.astro';

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: "Salon de l'Emploi & de la Formation 2026",
  startDate: '2026-10-30',
  endDate: '2026-10-31',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: {
    '@type': 'Place',
    name: "Salle d'exposition de Nouville",
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Nouméa',
      addressCountry: 'NC',
    },
  },
  isAccessibleForFree: true,
  organizer: {
    '@type': 'Organization',
    name: 'LabEvents',
  },
};

/* ------------------------------------------------------------------------
   SECTION « ILS SERONT PRÉSENTS » — MASQUÉE PAR DÉFAUT
   ------------------------------------------------------------------------
   CLAUDE.md section 3 : aucun logo de partenaire, sponsor ou entreprise ne
   doit apparaître tant que le partenariat n'est pas confirmé nommément par
   Philippe. La section est donc désactivée, et aucun logo factice ni bloc
   « logo à venir » n'est affiché.

   POUR LA RÉACTIVER, deux gestes :
   1. renseigner `exposantsConfirmes` avec les exposants validés — chaque
      entrée attend un logo déposé dans public/images/exposants/ ;
   2. passer `afficherPresence` à true.

   La section ne s'affiche que si les deux conditions sont réunies : une liste
   vide ne peut donc pas produire une bande vide en production.
   ------------------------------------------------------------------------ */
const afficherPresence = false;

interface ExposantConfirme {
  nom: string;
  /** Chemin public du logo, ex. `/images/exposants/nom.svg`. */
  logo: string;
}

const exposantsConfirmes: ExposantConfirme[] = [];

/*
  Quatre promesses — reprise du langage de la planche : verbe en capitales,
  complément court, pictogramme plein, colonnes séparées par un filet.
  Le pictogramme « Explorer » est en vert, comme sur la planche.
*/
const promesses = [
  {
    verbe: 'Rencontrer',
    complement: 'les recruteurs',
    texte:
      "Échangez directement avec les entreprises, présentez votre parcours et découvrez leurs besoins.",
    accent: 'orange',
    icone: `<circle cx="12" cy="7.5" r="4.2" /><path d="M3.5 21a8.5 8.5 0 0 1 17 0Z" />`,
  },
  {
    verbe: 'Découvrir',
    complement: 'les formations',
    texte: 'Identifiez les parcours proposés en Nouvelle-Calédonie et les débouchés associés.',
    accent: 'orange',
    icone: `<path d="M12 3 1 9l3 1.6V17h2v-5.3l6 3.3 11-6-11-6Z" /><path d="M7 13.6V17c0 1.7 2.2 3 5 3s5-1.3 5-3v-3.4l-5 2.7-5-2.7Z" />`,
  },
  {
    verbe: 'Explorer',
    complement: 'les métiers',
    texte:
      'Découvrez des secteurs, des environnements professionnels et des métiers parfois méconnus.',
    accent: 'village',
    icone: `<path fill-rule="evenodd" d="M10 2h4l.35 2.6c.6.2 1.18.54 1.7.94l2.4-1.05 2 3.46-1.95 1.6a7.9 7.9 0 0 1 0 1.9l1.95 1.6-2 3.46-2.4-1.05c-.52.4-1.1.73-1.7.94L14 22h-4l-.35-2.6a6.6 6.6 0 0 1-1.7-.94l-2.4 1.05-2-3.46 1.95-1.6a7.9 7.9 0 0 1 0-1.9L3.55 10.95l2-3.46 2.4 1.05c.52-.4 1.1-.73 1.7-.94L10 2Zm2 7a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" clip-rule="evenodd" />`,
  },
  {
    verbe: 'Construire',
    complement: 'votre projet',
    texte:
      "Bénéficiez de conseils pour votre orientation, votre recherche d'emploi ou votre reconversion.",
    accent: 'orange',
    icone: `<path fill-rule="evenodd" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 3.6a6.4 6.4 0 1 1 0 12.8 6.4 6.4 0 0 1 0-12.8Z" clip-rule="evenodd" /><path fill-rule="evenodd" d="M12 8.4a3.6 3.6 0 1 0 0 7.2 3.6 3.6 0 0 0 0-7.2Z" clip-rule="evenodd" />`,
  },
];

const chiffresCles = [
  {
    value: '2',
    unite: 'Jours',
    label: 'de rencontres',
    icone: `<rect x="3" y="5" width="18" height="16" rx="2" /><path stroke-linecap="round" d="M3 10h18M8 3v4M16 3v4" />`,
  },
  {
    value: '3 000',
    unite: 'Visiteurs',
    label: 'attendus (environ)',
    icone: `<circle cx="8" cy="8" r="3" /><circle cx="17" cy="9" r="2.5" /><path stroke-linecap="round" d="M2.5 20a5.5 5.5 0 0 1 11 0M14.5 20a4.2 4.2 0 0 1 7-3.1" />`,
  },
  {
    value: '2',
    unite: 'Univers',
    label: 'complémentaires',
    icone: `<path stroke-linecap="round" stroke-linejoin="round" d="m12 3 9 5-9 5-9-5 9-5Z" /><path stroke-linecap="round" stroke-linejoin="round" d="m3 14 9 5 9-5" />`,
  },
  {
    value: '100 %',
    unite: 'Gratuit',
    label: 'entrée libre',
    icone: `<circle cx="12" cy="12" r="9" /><path stroke-linecap="round" stroke-linejoin="round" d="m8.5 12 2.5 2.5 4.5-4.5" />`,
  },
];

const infosPratiques = [
  {
    label: 'Dates',
    valeur: '30 et 31 octobre 2026',
    icone: `<rect x="3" y="5" width="18" height="16" rx="2" /><path stroke-linecap="round" d="M3 10h18M8 3v4M16 3v4" />`,
  },
  {
    label: 'Horaires',
    valeur: '9 h à 17 h',
    icone: `<circle cx="12" cy="12" r="9" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3.5 2" />`,
  },
  {
    label: 'Lieu',
    valeur: "Salle d'exposition de Nouville, Nouméa",
    icone: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11Z" /><circle cx="12" cy="10" r="2.5" />`,
  },
  {
    label: 'Entrée',
    valeur: 'Libre et gratuite',
    icone: `<circle cx="12" cy="12" r="9" /><path stroke-linecap="round" stroke-linejoin="round" d="m8.5 12 2.5 2.5 4.5-4.5" />`,
  },
];
---

<BaseLayout
  title="Accueil"
  description="Salon de l'Emploi & de la Formation 2026 à Nouméa : 30 et 31 octobre, Salle d'exposition de Nouville. Entrée libre et gratuite."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
  </Fragment>

  <!-- ============================== HERO ==============================
       Aplat marine à gauche, visuel en découpe diagonale à droite à partir
       de lg — composition reprise de la vignette « 1. ACCUEIL ».

       Deux versions du portrait selon le breakpoint (seuil lg = 1024px,
       déjà utilisé pour la bascule nav desktop / menu mobile) :
       - desktop (lg+) : cadrage resserré à 3 personnages, sans le cadre en
         costume, pour mieux occuper la hauteur du panneau diagonal ;
       - mobile/tablette (< lg) : version complète à 4 personnages, qui
         occupe bien le format aspect-[4/3] du bloc image inline.
  -->
  <section class="relative overflow-hidden bg-marine text-blanc">
    <div class="absolute inset-y-0 right-0 hidden w-5/12 lg:block xl:w-1/2">
      <Visuel
        class="decoupe-diagonale h-full w-full"
        src="/images/hero-salon-desktop.webp"
        alt="Professionnelle avec un dossier, technicien casque orange et technicienne casque blanc, représentant les univers du Hall Emploi et du Hall Formation"
        width={1049}
        height={937}
        loading="eager"
        fit="contain"
        position="object-bottom"
        fondImage="#0c1a2f"
      />
    </div>

    <div class="relative mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:py-24">
      <div class="lg:max-w-lg xl:max-w-xl">
        <h1 class="font-titre text-5xl font-bold uppercase leading-none sm:text-6xl xl:text-7xl">
          Salon<br />
          de l'Emploi <span class="text-orange">&amp;</span><br />
          de la Formation
        </h1>

        <p class="mt-6 font-titre text-3xl font-bold uppercase text-orange sm:text-4xl">
          30 &amp; 31 octobre 2026
        </p>

        <p class="mt-4 text-sm font-bold uppercase leading-relaxed tracking-wide text-brume">
          Salle d'exposition de Nouville, Nouméa<br />
          Entrée libre et gratuite
        </p>

        <p class="mt-6 max-w-md text-base text-brume sm:text-lg">
          Deux jours pour rencontrer les recruteurs, découvrir les formations du territoire et
          explorer les métiers qui recrutent.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href="/exposer"
            class="inline-flex items-center justify-center rounded-md bg-village px-6 py-3.5 font-titre text-lg font-bold uppercase tracking-wide text-marine transition-opacity hover:opacity-90"
          >
            Devenir exposant
          </a>
          <a
            href="/preparer-ma-visite"
            class="inline-flex items-center justify-center rounded-md border-2 border-blanc px-6 py-3.5 font-titre text-lg font-bold uppercase tracking-wide text-blanc transition-colors hover:bg-blanc hover:text-marine"
          >
            Préparer ma visite
          </a>
        </div>
      </div>

      <Visuel
        class="mt-10 aspect-[4/3] w-full rounded-2xl lg:hidden"
        src="/images/hero-salon-mobile.webp"
        alt="Équipe du salon : cadre en costume, professionnelle avec un dossier, et deux techniciens casqués, représentant les univers du Hall Emploi et du Hall Formation"
        width={1448}
        height={1086}
        loading="eager"
        fit="contain"
        fondImage="#0a1930"
      />
    </div>
  </section>

  <!-- ====================== QUATRE PROMESSES =========================
       Bande infographique : colonnes centrées séparées par un filet fin,
       pictogrammes pleins, pas de cartes ni d'ombres (langage de la planche).
  -->
  <section class="bg-blanc">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
      <h2 class="text-center font-titre text-3xl font-bold uppercase text-marine sm:text-4xl">
        Pourquoi venir au salon ?
      </h2>

      <div class="mt-10 grid gap-px bg-marine/10 sm:grid-cols-2 lg:grid-cols-4">
        {
          promesses.map((promesse) => (
            <article class="flex flex-col items-center bg-blanc px-5 py-8 text-center">
              <svg
                class:list={[
                  'h-11 w-11',
                  promesse.accent === 'village' ? 'text-village' : 'text-marine',
                ]}
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                set:html={promesse.icone}
              />
              <h3 class="mt-5 font-titre text-2xl font-bold uppercase leading-none text-marine">
                {promesse.verbe}
              </h3>
              <p class="mt-1 font-titre text-lg font-semibold text-marine">{promesse.complement}</p>
              <p class="mt-3 text-sm leading-relaxed text-encre">{promesse.texte}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {
    /* ==================== ILS SERONT PRÉSENTS =======================
       Structure conservée mais MASQUÉE par défaut : voir le bloc de
       configuration en tête de fichier. Elle n'affiche que des logos
       réellement confirmés — jamais de vignette « logo à venir ».
    */
    afficherPresence && exposantsConfirmes.length > 0 && (
      <section class="border-t border-marine/10 bg-brume">
        <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
          <h2 class="text-center font-titre text-2xl font-bold uppercase tracking-tight text-marine sm:text-3xl">
            Ils seront présents
          </h2>

          <ul class="mt-9 grid grid-cols-2 items-center gap-6 sm:grid-cols-3 lg:grid-cols-5">
            {exposantsConfirmes.map((exposant) => (
              <li class="flex h-20 items-center justify-center">
                <img src={exposant.logo} alt={exposant.nom} class="max-h-16 w-auto" loading="lazy" />
              </li>
            ))}
          </ul>

          <div class="mt-9 text-center">
            <a
              href="/exposants"
              class="inline-flex items-center justify-center rounded-md bg-marine px-6 py-3 font-titre text-base font-bold uppercase tracking-wide text-blanc transition-opacity hover:opacity-90"
            >
              Voir tous les exposants
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- ========================= DEUX UNIVERS ==========================
       Deux cartes à parité, texte en haut et zone image en pied — reprise
       du bloc « Deux espaces complémentaires » de la planche.
  -->
  <section class="border-t border-marine/10 bg-blanc">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
      <h2 class="text-center font-titre text-3xl font-bold uppercase text-marine sm:text-4xl">
        Deux univers complémentaires
      </h2>

      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <article class="flex flex-col overflow-hidden rounded-2xl border border-marine/15 bg-brume">
          <div class="flex flex-1 flex-col p-6 sm:p-8">
            <p class="text-xs font-bold uppercase tracking-widest text-orange-dark">Univers 1</p>
            <h3 class="mt-2 font-titre text-2xl font-bold uppercase text-marine sm:text-3xl">
              Hall Emploi
            </h3>
            <div class="mt-3 h-1 w-12 rounded-full bg-orange" aria-hidden="true"></div>
            <p class="mt-4 flex-1 text-sm text-encre sm:text-base">
              Entreprises qui recrutent, offres d'emploi, rencontres avec les candidats et
              découverte des métiers.
            </p>
            <a
              href="/le-salon"
              class="mt-6 inline-flex w-fit items-center justify-center rounded-md bg-marine px-5 py-2.5 font-titre text-base font-bold uppercase tracking-wide text-blanc transition-opacity hover:opacity-90"
            >
              Découvrir le salon
            </a>
          </div>
          <Visuel
            class="h-44 w-full sm:h-52"
            src="/images/hall-emploi-formation.webp"
            alt="Recruteuse échangeant avec deux visiteurs sur un stand du Hall Emploi"
            width={1672}
            height={941}
            position="object-[center_22%]"
          />
        </article>

        <article class="flex flex-col overflow-hidden rounded-2xl bg-village">
          <div class="flex flex-1 flex-col p-6 sm:p-8">
            <p class="text-xs font-bold uppercase tracking-widest text-marine">Univers 2</p>
            <h3 class="mt-2 font-titre text-2xl font-bold uppercase text-blanc sm:text-3xl">
              Hall Formation
            </h3>
            <div class="mt-3 h-1 w-12 rounded-full bg-marine" aria-hidden="true"></div>
            <p class="mt-4 flex-1 text-sm text-marine sm:text-base">
              Organismes de formation, orientation, découverte des parcours et information sur les
              formations et les débouchés.
            </p>
            <a
              href="/le-salon"
              class="mt-6 inline-flex w-fit items-center justify-center rounded-md bg-marine px-5 py-2.5 font-titre text-base font-bold uppercase tracking-wide text-blanc transition-opacity hover:opacity-90"
            >
              Découvrir le salon
            </a>
          </div>
          <Visuel
            class="h-44 w-full sm:h-52"
            src="/images/hall-formation.webp"
            alt="Organisme de formation présentant un parcours à des visiteurs du Hall Formation"
            width={1672}
            height={941}
            position="object-[center_18%]"
            tone="village"
          />
        </article>
      </div>
    </div>
  </section>

  <!-- ========================= OFFRES DU SALON =========================
       Bloc compact reliant l'accueil au catalogue d'offres (Lot 1 du
       dispositif « Offres et candidatures », voir docs/OFFRES.md).
  -->
  <section class="border-t border-marine/10 bg-blanc">
    <div class="mx-auto max-w-6xl px-4 py-14 text-center sm:px-6 lg:py-16">
      <h2 class="font-titre text-3xl font-bold uppercase text-marine sm:text-4xl">
        Consultez les offres du salon
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base text-encre sm:text-lg">
        Parcourez les postes proposés par les exposants et sélectionnez jusqu'à cinq offres avant de
        rencontrer les recruteurs sur le salon.
      </p>
      <div class="mt-8">
        <a
          href="/offres"
          class="inline-flex items-center justify-center rounded-md bg-marine px-6 py-3.5 font-titre text-lg font-bold uppercase tracking-wide text-blanc transition-opacity hover:opacity-90"
        >
          Voir les offres
        </a>
      </div>
    </div>
  </section>

  <!-- ========================= CHIFFRES CLÉS =========================
       Bandeau chiffré au langage de la page « Le salon » de la planche :
       pictogramme en filet, nombre très large, unité puis précision.
  -->
  <section class="border-t border-marine/10 bg-brume" aria-labelledby="chiffres-titre">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <h2 id="chiffres-titre" class="sr-only">Le salon en chiffres</h2>

      <ul class="grid grid-cols-2 gap-px bg-marine/10 lg:grid-cols-4">
        {
          chiffresCles.map((chiffre) => (
            <li class="flex flex-col items-center bg-brume px-4 py-8 text-center">
              <svg
                class="h-8 w-8 text-marine"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
                set:html={chiffre.icone}
              />
              <span class="mt-4 block font-titre text-5xl font-bold leading-none text-marine sm:text-6xl">
                {chiffre.value}
              </span>
              <span class="mt-2 block font-titre text-lg font-bold uppercase leading-none tracking-wide text-marine">
                {chiffre.unite}
              </span>
              <span class="mt-1 block text-sm text-encre">{chiffre.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ========================= BLOC EXPOSANTS ========================
       Bande marine, accent orange, CTA vert — même hiérarchie que le bloc
       commercial de la page « Exposer » de la planche.
  -->
  <section class="bg-marine text-blanc">
    <div
      class="mx-auto grid max-w-6xl items-start gap-8 px-4 py-14 sm:px-6 lg:grid-cols-12 lg:gap-12 lg:py-16"
    >
      <div class="order-1 lg:col-span-7">
        <p class="text-xs font-bold uppercase tracking-widest text-orange">Devenir exposant</p>
        <h2 class="mt-3 font-titre text-3xl font-bold uppercase leading-tight sm:text-4xl">
          Recrutez, présentez vos formations et développez votre visibilité
        </h2>
        <div class="mt-4 h-1 w-14 rounded-full bg-orange" aria-hidden="true"></div>
        <p class="mt-5 max-w-2xl text-base text-brume sm:text-lg">
          Entreprises, organismes de formation, institutions et acteurs de l'accompagnement :
          participez à un événement conçu pour favoriser les rencontres directes avec les
          publics du territoire.
        </p>
        <p class="mt-3 text-sm font-bold uppercase tracking-wide text-orange">
          37 emplacements commercialisés
        </p>
        <a
          href="/exposer"
          class="mt-7 inline-flex items-center justify-center rounded-md bg-village px-6 py-3.5 font-titre text-lg font-bold uppercase tracking-wide text-marine transition-opacity hover:opacity-90"
        >
          Découvrir les offres exposants
        </a>
      </div>

      <Visuel
        class="order-2 aspect-[4/3] rounded-2xl lg:col-span-5"
        src="/images/exposants-salon.webp"
        alt="Stand exposant en activité : échange entre une exposante et deux visiteurs du salon"
        width={1672}
        height={941}
        position="object-[78%_center]"
      />
    </div>
  </section>

  <!-- ===================== INFORMATIONS PRATIQUES ====================
       Encadré synthétique à pictogrammes, dans l'esprit du bloc « Infos
       pratiques » de la page « Préparer ma visite » de la planche.
  -->
  <section class="bg-blanc">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
      <h2 class="text-center font-titre text-3xl font-bold uppercase text-marine sm:text-4xl">
        Informations pratiques
      </h2>

      <div class="mt-10 overflow-hidden rounded-2xl border border-marine/15">
        <ul class="grid gap-px bg-marine/10 sm:grid-cols-2 lg:grid-cols-4">
          {
            infosPratiques.map((info) => (
              <li class="flex flex-col gap-3 bg-blanc p-6">
                <svg
                  class="h-7 w-7 text-orange"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.7"
                  aria-hidden="true"
                  set:html={info.icone}
                />
                <span class="text-xs font-bold uppercase tracking-widest text-marine/70">
                  {info.label}
                </span>
                <span class="font-titre text-lg font-bold leading-snug text-marine">{info.valeur}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-9 text-center">
        <a
          href="/preparer-ma-visite"
          class="inline-flex items-center justify-center rounded-md bg-marine px-6 py-3.5 font-titre text-lg font-bold uppercase tracking-wide text-blanc transition-opacity hover:opacity-90"
        >
          Préparer ma visite
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
