---
import BaseLayout from '../layouts/BaseLayout.astro';
import OffreSelection from '../components/OffreSelection.astro';
import TallyCandidatureEmbed from '../components/TallyCandidatureEmbed.astro';
import { getOffresPubliees, offreSlug } from '../lib/offres';

const offresEligibles = (await getOffresPubliees()).filter((offre) => offre.data.accepteCandidaturesEnLigne);

const offresEligiblesDonnees = offresEligibles.map((offre) => ({
  reference: offre.data.reference,
  intitule: offre.data.intitule,
  exposantNom: offre.data.exposantNom,
  href: `/offres/${offreSlug(offre)}`,
}));

const tallyBaseUrl = import.meta.env.PUBLIC_TALLY_CANDIDATURE_URL ?? '';
---

<BaseLayout
  title="Candidater aux offres du salon"
  description="Préparez votre candidature avant le Salon de l'Emploi & de la Formation 2026 et sélectionnez les offres qui vous intéressent."
>
  <!-- ============================== HERO ============================== -->
  <section class="bg-marine text-blanc">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:py-20">
      <p class="text-xs font-bold uppercase tracking-widest text-orange">Offres et candidatures</p>
      <h1 class="mt-3 font-titre text-4xl font-bold uppercase leading-none sm:text-5xl">
        Candidater aux offres du salon
      </h1>
      <p class="mt-6 max-w-2xl text-base text-brume sm:text-lg">
        Préparez votre candidature avant le salon et venez rencontrer les recruteurs les 30 et 31
        octobre 2026 à la Salle d'exposition de Nouville.
      </p>
    </div>
  </section>

  <section class="border-b border-marine/10 bg-orange/10">
    <div class="mx-auto max-w-4xl px-4 py-4 sm:px-6">
      <p class="text-center text-sm font-semibold text-marine">
        La candidature en ligne prépare la rencontre. Elle ne garantit ni entretien, ni réponse, ni
        recrutement.
      </p>
      <p class="mt-1 text-center text-sm font-semibold text-marine">
        Les candidatures seront transmises aux recruteurs après la clôture du salon.
      </p>
    </div>
  </section>

  <section class="bg-blanc">
    <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:py-14">
      <!-- Message accessible : offres écartées de la sélection (référence inconnue,
           offre retirée/clôturée, ou n'acceptant pas la candidature en ligne). -->
      <p
        id="message-offres-ecartees"
        class="hidden rounded-2xl border border-orange/40 bg-orange/10 p-4 text-sm font-semibold text-marine"
        role="status"
        aria-live="polite"
      >
        Une ou plusieurs offres de votre sélection ne sont plus disponibles pour la candidature en
        ligne.
      </p>

      <!-- ========================= MA SÉLECTION ========================= -->
      <div class="mt-6 rounded-2xl border border-marine/15 bg-brume p-6 sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="font-titre text-xl font-bold uppercase text-marine">Ma sélection</h2>
          <a
            href="/ma-selection"
            data-preserve-selection
            data-href-base="/ma-selection"
            class="text-sm font-semibold text-marine underline underline-offset-2 hover:text-village-dark"
          >
            Modifier ma sélection
          </a>
        </div>

        <p class="mt-2 text-sm font-semibold text-marine">
          <span data-compteur-nombre>0</span> offre(s) sélectionnée(s) sur 5
        </p>

        <div data-selection-vide class="hidden mt-4 text-sm text-encre">
          <p>
            Vous n'avez sélectionné aucune offre. Vous pouvez néanmoins déposer votre profil afin
            que LabEvents vous oriente vers les exposants les plus adaptés à votre profil.
          </p>
        </div>

        <div data-selection-presente class="hidden mt-4">
          <ul data-liste-selection class="grid grid-cols-1 gap-3 sm:grid-cols-2" aria-label="Offres sélectionnées"></ul>
        </div>
      </div>

      <!-- ==================== ORIENTATION LABEVENTS ==================== -->
      <div class="mt-6 rounded-2xl border border-marine/15 bg-blanc p-6 sm:p-8">
        <label class="flex items-start gap-3 text-sm font-semibold text-marine">
          <input
            id="case-orientation"
            type="checkbox"
            class="mt-0.5 h-5 w-5 flex-shrink-0 rounded border-marine/30 text-village focus:ring-village/40"
          />
          <span>
            Je souhaite que LabEvents oriente ma candidature vers les exposants les plus adaptés à
            mon profil.
          </span>
        </label>
      </div>

      <!-- ========================= FORMULAIRE TALLY ========================= -->
      <div class="mt-10">
        <h2 class="font-titre text-xl font-bold uppercase text-marine">Formulaire de candidature</h2>
        <p class="mt-3 text-sm text-encre">
          Vos informations, votre CV et vos consentements seront transmis aux exposants
          correspondant aux offres sélectionnées (et, selon votre choix, à d'autres exposants) après
          la clôture du salon. Vos données sont conservées jusqu'au 31 décembre 2026. Pour en savoir
          plus, consultez notre{' '}
          <a href="/confidentialite" class="font-semibold text-marine underline hover:text-village-dark">
            politique de confidentialité
          </a>
          . Contact :{' '}
          <a href="mailto:labevents@icloud.com" class="font-semibold text-marine underline hover:text-village-dark">
            labevents@icloud.com
          </a>
          .
        </p>

        <div class="mt-6">
          <TallyCandidatureEmbed tallyBaseUrl={tallyBaseUrl} />
        </div>
      </div>
    </div>
  </section>

  <OffreSelection />
  <script type="application/json" id="offres-eligibles-donnees" set:html={JSON.stringify(offresEligiblesDonnees)} />
  <p id="annonce-selection" class="sr-only" role="status" aria-live="polite"></p>

  <script>
    import { initSelectionUI, EVENEMENT_SELECTION_CHANGEE } from '../lib/selection-ui';
    import {
      lireSelection,
      filtrerReferencesConnues,
      estOrientationDemandee,
      appliquerOrientationAlUrl,
      construireUrlTally,
      type OffreCandidature,
    } from '../lib/candidature-selection';

    interface OffreResume extends OffreCandidature {
      href: string;
    }

    const idDonnees = 'offres-eligibles-donnees';

    function lireOffresEligibles(): OffreResume[] {
      const element = document.getElementById(idDonnees);
      if (!element?.textContent) return [];
      try {
        const donnees = JSON.parse(element.textContent);
        return Array.isArray(donnees) ? donnees : [];
      } catch {
        return [];
      }
    }

    const offresEligibles = lireOffresEligibles();
    const parReference = new Map(offresEligibles.map((offre) => [offre.reference, offre]));
    const referencesConnues = new Set(parReference.keys());

    const messageEcartees = document.getElementById('message-offres-ecartees');
    const caseOrientation = document.getElementById('case-orientation') as HTMLInputElement | null;
    const iframe = document.getElementById('tally-candidature-iframe') as HTMLIFrameElement | null;
    const etatChargement = document.getElementById('tally-etat-chargement');
    const tallyBase = iframe?.dataset.tallyBase ?? '';

    // État initial de la case : jamais précochée, sauf si l'URL contient déjà orientation=1.
    if (caseOrientation) {
      caseOrientation.checked = estOrientationDemandee(new URLSearchParams(window.location.search));
    }

    function mettreAJourEcartees(selectionBrute: string[]): void {
      const { inconnues } = filtrerReferencesConnues(selectionBrute, referencesConnues);
      messageEcartees?.classList.toggle('hidden', inconnues.length === 0);
    }

    function recalculerTally(): void {
      if (!iframe || !tallyBase) return;
      const params = new URLSearchParams(window.location.search);
      const { connues } = filtrerReferencesConnues(lireSelection(params), referencesConnues);
      const offresValides = connues
        .map((reference) => parReference.get(reference))
        .filter((offre): offre is OffreResume => Boolean(offre));
      const orientation = caseOrientation?.checked ?? false;
      const urlComplete = construireUrlTally(tallyBase, offresValides, orientation);
      if (iframe.dataset.tallySrc !== urlComplete) {
        // data-tally-src : c'est cet attribut que le script officiel Tally
        // (widgets/embed.js, chargé par TallyCandidatureEmbed.astro) utilise
        // pour retrouver l'iframe à redimensionner lors des messages
        // Tally.FormHeightChanged. On affecte `data-tally-src` d'abord, puis
        // on appelle tallyInitEmbed() : c'est lui (jamais nous directement)
        // qui affecte `src` et déclenche le scan Tally — dans cet ordre,
        // sinon le mécanisme de hauteur dynamique ne s'initialise jamais.
        iframe.dataset.tallySrc = urlComplete;
        iframe.removeAttribute('src');
        (window as any).tallyInitEmbed?.();
      }
    }

    iframe?.addEventListener('load', () => {
      iframe.classList.remove('hidden');
      etatChargement?.classList.add('hidden');
    });

    document.addEventListener(EVENEMENT_SELECTION_CHANGEE, () => {
      recalculerTally();
    });

    caseOrientation?.addEventListener('change', () => {
      const url = appliquerOrientationAlUrl(new URL(window.location.href), caseOrientation.checked);
      window.history.replaceState(window.history.state, '', url);
      recalculerTally();
    });

    // Le message « offres écartées » se calcule une seule fois, à partir de
    // l'URL brute telle que reçue par le visiteur — initSelectionUI() nettoie
    // ensuite silencieusement les références invalides de l'URL (comportement
    // voulu du Lot 1), donc ce calcul doit précéder cet appel.
    mettreAJourEcartees(lireSelection(new URLSearchParams(window.location.search)));

    // initSelectionUI() lit offre1..offre5, filtre via les offres éligibles
    // (offres-eligibles-donnees), peuple le récapitulatif « Ma sélection » et
    // déclenche EVENEMENT_SELECTION_CHANGEE une première fois à l'initialisation
    // (ce qui déclenche recalculerTally() ci-dessus via l'écouteur).
    initSelectionUI({ offresDisponiblesId: idDonnees });
  </script>
</BaseLayout>
