---
import BaseLayout from '../layouts/BaseLayout.astro';
import Visuel from '../components/Visuel.astro';

/*
  Icônes en trait (style repris de `exposer.astro` — bénéfices, documents) :
  fill="none", stroke="currentColor", viewBox 0 0 24 24.
*/
const benefices = [
  {
    verbe: 'Rencontrer',
    complement: 'des employeurs et des professionnels',
    icone: `<circle cx="8" cy="8" r="3" /><circle cx="17" cy="9" r="2.5" /><path stroke-linecap="round" d="M2.5 20a5.5 5.5 0 0 1 11 0M14.5 20a4.2 4.2 0 0 1 7-3.1" />`,
  },
  {
    verbe: 'Découvrir',
    complement: 'des métiers et des secteurs d’activité',
    icone: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 3 1 9l3 1.6V17h2v-5.3l6 3.3 11-6-11-6Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M7 13.6V17c0 1.7 2.2 3 5 3s5-1.3 5-3v-3.4" />`,
  },
  {
    verbe: 'S’informer',
    complement: 'sur les formations et les parcours',
    icone: `<circle cx="12" cy="12" r="9" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 8h.01M11.25 11h1v5h1" />`,
  },
  {
    verbe: 'Avancer',
    complement: 'dans son projet professionnel',
    icone: `<path stroke-linecap="round" stroke-linejoin="round" d="M4 19V10m6.5 9V5m6.5 14v-7" /><path stroke-linecap="round" stroke-linejoin="round" d="m3 9 6.5-5L15 8.5 21 4" />`,
  },
];

const checkIcon = `<path stroke-linecap="round" stroke-linejoin="round" d="m5 12 5 5 9-9" />`;

const hallPoints = [
  'Emplois et recrutements',
  'Offres d’emploi',
  'Rencontres avec les candidats',
  'Découverte des métiers',
];

const formationPoints = [
  'Organismes de formation',
  'Orientation',
  'Découverte des parcours',
  'Formations et débouchés',
];

const publics = [
  "Demandeurs d'emploi",
  'Salariés en réflexion ou en reconversion',
  'Étudiants et jeunes en orientation',
  "Familles accompagnant un projet d'orientation",
  'Professionnels souhaitant développer leur réseau',
];

const actions = [
  {
    label: 'Échanger avec les exposants',
    icone: `<path stroke-linecap="round" stroke-linejoin="round" d="M4 8.5h13m0 0-4-4m4 4-4 4" /><path stroke-linecap="round" stroke-linejoin="round" d="M20 15.5H7m0 0 4 4m-4-4 4-4" />`,
  },
  {
    label: 'Découvrir des opportunités',
    icone: `<circle cx="10.5" cy="10.5" r="6.5" /><path stroke-linecap="round" d="m20 20-4.7-4.7" />`,
  },
  {
    label: 'Mieux comprendre les métiers',
    icone: `<path fill-rule="evenodd" clip-rule="evenodd" fill="currentColor" stroke="none" d="M10.5 2.3h3l.3 2.2c.5.2 1 .4 1.4.8l2-.9 1.7 3-1.6 1.3a6.6 6.6 0 0 1 0 1.6l1.6 1.3-1.7 3-2-.9c-.4.4-.9.6-1.4.8l-.3 2.2h-3l-.3-2.2a5.5 5.5 0 0 1-1.4-.8l-2 .9-1.7-3 1.6-1.3a6.6 6.6 0 0 1 0-1.6L5.1 7.4l1.7-3 2 .9c.4-.4.9-.6 1.4-.8l.3-2.2Zm1.5 6.2a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z" />`,
  },
  {
    label: 'Identifier des formations',
    icone: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 3 1 9l3 1.6V17h2v-5.3l6 3.3 11-6-11-6Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M7 13.6V17c0 1.7 2.2 3 5 3s5-1.3 5-3v-3.4" />`,
  },
  {
    label: 'Obtenir des conseils',
    icone: `<path stroke-linecap="round" stroke-linejoin="round" d="M4 5.5h16v10H9l-4 3.5v-3.5H4v-10Z" /><path stroke-linecap="round" d="M8 9h8M8 12.5h5" />`,
  },
  {
    label: 'Préparer les prochaines étapes de son parcours',
    icone: `<path stroke-linecap="round" d="M3 20.5h18" /><path stroke-linecap="round" stroke-linejoin="round" d="M5 19v-7l5-3.5 4 2.5 5-6" /><path stroke-linecap="round" stroke-linejoin="round" d="M15.5 5h3.5v3.5" />`,
  },
];

const infosPratiques = [
  {
    label: 'Dates',
    valeur: 'Vendredi 30 et samedi 31 octobre 2026',
    icone: `<rect x="3" y="5" width="18" height="16" rx="2" /><path stroke-linecap="round" d="M3 10h18M8 3v4M16 3v4" />`,
  },
  {
    label: 'Lieu',
    valeur: "Salle d'exposition de Nouville — Nouméa",
    icone: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11Z" /><circle cx="12" cy="10" r="2.5" />`,
  },
  {
    label: 'Entrée',
    valeur: 'Gratuite',
    icone: `<circle cx="12" cy="12" r="9" /><path stroke-linecap="round" stroke-linejoin="round" d="m8.5 12 2.5 2.5 4.5-4.5" />`,
  },
  {
    label: 'Public',
    valeur: 'Tout public',
    icone: `<circle cx="8" cy="8" r="3" /><circle cx="17" cy="9" r="2.5" /><path stroke-linecap="round" d="M2.5 20a5.5 5.5 0 0 1 11 0M14.5 20a4.2 4.2 0 0 1 7-3.1" />`,
  },
];
---

<BaseLayout
  title="Le salon"
  description="Découvrez le Salon de l'Emploi & de la Formation 2026, organisé les 30 et 31 octobre à Nouville, Nouméa."
>
  <!-- ============================== HERO ============================== -->
  <section class="bg-marine text-blanc">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-20">
      <p class="text-xs font-bold uppercase tracking-widest text-orange">Le salon</p>
      <h1 class="mt-3 max-w-3xl font-titre text-4xl font-bold uppercase leading-none sm:text-5xl xl:text-6xl">
        Deux jours pour construire votre avenir professionnel
      </h1>

      <p class="mt-6 max-w-2xl text-base text-brume sm:text-lg">
        Le Salon de l'Emploi &amp; de la Formation réunit en un même lieu les entreprises, les
        organismes de formation, les institutions et les acteurs de l'accompagnement
        professionnel.
      </p>
      <p class="mt-4 max-w-2xl text-base text-brume sm:text-lg">
        Les 30 et 31 octobre 2026, les visiteurs pourront rencontrer directement les exposants,
        découvrir des métiers, identifier des parcours de formation et mieux préparer leurs
        projets professionnels.
      </p>

      <ul class="mt-8 grid grid-cols-2 gap-x-6 gap-y-3 text-sm font-semibold uppercase tracking-wide text-brume sm:flex sm:flex-wrap sm:gap-x-8">
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-orange" aria-hidden="true"></span>
          30 et 31 octobre 2026
        </li>
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-orange" aria-hidden="true"></span>
          Salle d'exposition de Nouville
        </li>
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-orange" aria-hidden="true"></span>
          Nouméa
        </li>
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-orange" aria-hidden="true"></span>
          Entrée gratuite
        </li>
      </ul>

      <!--
        Hiérarchie des CTA : les deux univers du salon priment (c'est l'objet
        de cette page), « Préparer ma visite » reste accessible mais en lien
        secondaire discret plutôt qu'en bouton, pour ne pas concurrencer les
        deux boutons de découverte.
      -->
      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="#hall-emploi"
          class="inline-flex items-center justify-center rounded-md bg-village px-6 py-3.5 text-center font-titre text-lg font-bold uppercase tracking-wide text-marine transition-opacity hover:opacity-90"
        >
          Découvrir le Hall Emploi
        </a>
        <a
          href="#hall-formation"
          class="inline-flex items-center justify-center rounded-md border-2 border-blanc px-6 py-3.5 text-center font-titre text-lg font-bold uppercase tracking-wide text-blanc transition-colors hover:bg-blanc hover:text-marine"
        >
          Découvrir le Hall Formation
        </a>
      </div>

      <a
        href="/preparer-ma-visite"
        class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brume underline decoration-brume/40 underline-offset-4 transition-colors hover:text-blanc hover:decoration-blanc"
      >
        Préparer ma visite
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>

  <!-- ===================== PRÉSENTATION DU SALON ===================== -->
  <section class="bg-blanc">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
      <h2 class="text-center font-titre text-3xl font-bold uppercase text-marine sm:text-4xl">
        Un lieu de rencontres et d'opportunités
      </h2>
      <p class="mx-auto mt-5 max-w-3xl text-center text-encre">
        Le salon a été conçu pour faciliter les échanges directs entre les publics et les acteurs
        de l'emploi, de la formation et de l'orientation. Il permet de réunir en un même lieu des
        informations, des interlocuteurs et des opportunités utiles pour construire ou faire
        évoluer un projet professionnel.
      </p>

      <div class="mt-10 grid gap-px bg-marine/10 sm:grid-cols-2 lg:grid-cols-4">
        {
          benefices.map((benefice) => (
            <article class="flex flex-col items-center bg-blanc px-5 py-8 text-center">
              <svg
                class="h-9 w-9 text-orange"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
                set:html={benefice.icone}
              />
              <h3 class="mt-4 font-titre text-xl font-bold uppercase leading-none text-marine">
                {benefice.verbe}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-encre">{benefice.complement}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================= DEUX UNIVERS ========================== -->
  <section class="border-t border-marine/10 bg-brume">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
      <h2 class="text-center font-titre text-3xl font-bold uppercase text-marine sm:text-4xl">
        Deux univers complémentaires
      </h2>

      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <article id="hall-emploi" class="flex scroll-mt-24 flex-col overflow-hidden rounded-2xl border border-marine/15 bg-blanc">
          <div class="flex flex-1 flex-col p-6 sm:p-8">
            <p class="text-xs font-bold uppercase tracking-widest text-orange-dark">Univers 1</p>
            <h3 class="mt-2 font-titre text-2xl font-bold uppercase text-marine sm:text-3xl">
              Hall Emploi
            </h3>
            <div class="mt-3 h-1 w-12 rounded-full bg-orange" aria-hidden="true"></div>
            <p class="mt-4 text-sm text-encre sm:text-base">
              Entreprises qui recrutent, offres d'emploi, rencontres avec les candidats et
              découverte des métiers.
            </p>
            <ul class="mt-4 flex-1 space-y-2.5 text-sm text-encre">
              {
                hallPoints.map((point) => (
                  <li class="flex items-start gap-2">
                    <svg
                      class="mt-0.5 h-4 w-4 flex-shrink-0 text-marine"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                      set:html={checkIcon}
                    />
                    <span>{point}</span>
                  </li>
                ))
              }
            </ul>
            <a
              href="/exposants"
              class="mt-6 inline-flex w-fit items-center justify-center rounded-md bg-marine px-5 py-2.5 font-titre text-base font-bold uppercase tracking-wide text-blanc transition-opacity hover:opacity-90"
            >
              Découvrir le Hall Emploi
            </a>
          </div>
          <Visuel
            class="h-44 w-full sm:h-52"
            src="/images/hall-emploi-formation.webp"
            alt="Recruteuse échangeant avec deux visiteurs sur un stand du Hall Emploi"
            width={1672}
            height={941}
            position="object-[center_22%]"
          />
        </article>

        <article id="hall-formation" class="flex scroll-mt-24 flex-col overflow-hidden rounded-2xl bg-village">
          <div class="flex flex-1 flex-col p-6 sm:p-8 text-marine">
            <p class="text-xs font-bold uppercase tracking-widest text-marine/70">Univers 2</p>
            <h3 class="mt-2 font-titre text-2xl font-bold uppercase text-blanc sm:text-3xl">
              Hall Formation
            </h3>
            <div class="mt-3 h-1 w-12 rounded-full bg-marine" aria-hidden="true"></div>
            <p class="mt-4 text-sm sm:text-base">
              Organismes de formation, orientation, découverte des parcours et information sur les
              formations et les débouchés.
            </p>
            <ul class="mt-4 flex-1 space-y-2.5 text-sm">
              {
                formationPoints.map((point) => (
                  <li class="flex items-start gap-2">
                    <svg
                      class="mt-0.5 h-4 w-4 flex-shrink-0 text-marine"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                      set:html={checkIcon}
                    />
                    <span>{point}</span>
                  </li>
                ))
              }
            </ul>
            <a
              href="/exposants"
              class="mt-6 inline-flex w-fit items-center justify-center rounded-md bg-marine px-5 py-2.5 font-titre text-base font-bold uppercase tracking-wide text-blanc transition-opacity hover:opacity-90"
            >
              Découvrir le Hall Formation
            </a>
          </div>
          <Visuel
            class="h-44 w-full sm:h-52"
            src="/images/hall-formation.webp"
            alt="Organisme de formation présentant un parcours à des visiteurs du Hall Formation"
            width={1672}
            height={941}
            position="object-[center_18%]"
            tone="village"
          />
        </article>
      </div>
    </div>
  </section>

  <!-- =================== À QUI S'ADRESSE LE SALON ? =================== -->
  <section class="bg-blanc">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
      <h2 class="text-center font-titre text-3xl font-bold uppercase text-marine sm:text-4xl">
        Un salon ouvert à tous les publics
      </h2>

      <ul class="mx-auto mt-10 grid max-w-4xl gap-4 sm:grid-cols-2">
        {
          publics.map((publicVise) => (
            <li class="flex items-center gap-3 rounded-xl border border-marine/15 bg-brume px-5 py-4 text-sm font-semibold text-marine sm:text-base">
              <span class="h-2 w-2 flex-shrink-0 rounded-full bg-orange" aria-hidden="true" />
              {publicVise}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ==================== PENDANT VOTRE VISITE ======================= -->
  <section class="border-t border-marine/10 bg-brume">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
      <h2 class="text-center font-titre text-3xl font-bold uppercase text-marine sm:text-4xl">
        Pendant votre visite
      </h2>

      <div class="mt-10 grid gap-px bg-marine/10 sm:grid-cols-2 lg:grid-cols-3">
        {
          actions.map((action) => (
            <article class="flex flex-col items-center bg-blanc px-5 py-8 text-center">
              <svg
                class="h-9 w-9 text-orange"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
                set:html={action.icone}
              />
              <p class="mt-4 text-sm font-semibold leading-snug text-marine sm:text-base">
                {action.label}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== INFORMATIONS PRATIQUES ====================== -->
  <section class="bg-blanc">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
      <h2 class="text-center font-titre text-3xl font-bold uppercase text-marine sm:text-4xl">
        Informations pratiques
      </h2>

      <div class="mt-10 overflow-hidden rounded-2xl border border-marine/15">
        <ul class="grid gap-px bg-marine/10 sm:grid-cols-2 lg:grid-cols-4">
          {
            infosPratiques.map((info) => (
              <li class="flex flex-col gap-3 bg-blanc p-6">
                <svg
                  class="h-7 w-7 text-orange"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.7"
                  aria-hidden="true"
                  set:html={info.icone}
                />
                <span class="text-xs font-bold uppercase tracking-widest text-marine/70">
                  {info.label}
                </span>
                <span class="font-titre text-lg font-bold leading-snug text-marine">
                  {info.valeur}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-9 text-center">
        <a
          href="/preparer-ma-visite"
          class="inline-flex items-center justify-center rounded-md bg-marine px-6 py-3.5 font-titre text-lg font-bold uppercase tracking-wide text-blanc transition-opacity hover:opacity-90"
        >
          Préparer ma visite
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
