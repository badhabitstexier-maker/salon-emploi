---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getProgrammePublie,
  programmeSlug,
  universLabels,
  typeLabels,
  journeeLabels,
} from '../../lib/programme';
import { getExposantsPublies, exposantSlug } from '../../lib/exposants';

export async function getStaticPaths() {
  const items = await getProgrammePublie();
  return items.map((item) => ({
    params: { slug: programmeSlug(item) },
    props: { item },
  }));
}

const { item } = Astro.props;
const { data } = item;

const styleUnivers = {
  hall: { badge: 'bg-marine text-blanc', accent: 'text-orange' },
  village: { badge: 'bg-village-dark text-blanc', accent: 'text-village' },
  /* accent en text-brume (et non text-encre) : ce bloc s'affiche sur le hero
     bg-marine, où text-encre serait quasi invisible (texte quasi de la même
     teinte que le fond). */
  transversal: { badge: 'bg-encre text-blanc', accent: 'text-brume' },
}[data.univers];

let exposantLie = null;
if (data.exposant_lie) {
  const exposants = await getExposantsPublies();
  exposantLie = exposants.find((exposant) => exposantSlug(exposant) === data.exposant_lie) ?? null;
}

const formateurDate = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' });
const dateMiseAJour = data.date_mise_a_jour ? formateurDate.format(data.date_mise_a_jour) : null;
---

<BaseLayout title={data.titre} description={data.accroche}>
  <section class="bg-marine text-blanc">
    <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:py-14">
      <a
        href="/programme"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-brume underline decoration-brume/40 underline-offset-4 transition-colors hover:text-blanc hover:decoration-blanc"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Retour au programme
      </a>

      <div class="mt-6 flex flex-wrap items-center gap-2">
        {
          data.mise_en_avant && (
            <span class="w-fit rounded-full bg-orange-dark px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-blanc">
              Temps fort
            </span>
          )
        }
        <span class:list={['w-fit rounded-full px-2.5 py-1 text-xs font-bold uppercase tracking-wide', styleUnivers.badge]}>
          {universLabels[data.univers]}
        </span>
        <span class="w-fit rounded-full border border-blanc/30 px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-blanc">
          {typeLabels[data.type]}
        </span>
      </div>

      <h1 class="mt-4 max-w-3xl font-titre text-3xl font-bold uppercase leading-none sm:text-4xl">
        {data.titre}
      </h1>

      <p class:list={['mt-4 font-titre text-xl font-bold', styleUnivers.accent]}>
        {journeeLabels[data.date]} 2026 · {data.heure_debut}{data.heure_fin ? `–${data.heure_fin}` : ''}
      </p>

      {
        data.lieu && (
          <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-brume/80">{data.lieu}</p>
        )
      }
    </div>
  </section>

  <section class="bg-blanc">
    <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:py-14">
      <p class="text-lg font-semibold text-marine">{data.accroche}</p>

      <div class="mt-6 space-y-4 text-encre">
        {data.description.split(/\n{2,}/).map((paragraphe) => <p>{paragraphe}</p>)}
      </div>

      {
        data.publics && data.publics.length > 0 && (
          <div class="mt-10">
            <h2 class="font-titre text-lg font-bold uppercase text-marine">Publics concernés</h2>
            <ul class="mt-3 flex flex-wrap gap-2 text-sm text-encre">
              {data.publics.map((public_) => (
                <li class="rounded-full border border-marine/20 bg-brume px-3 py-1.5">{public_}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        data.intervenants && data.intervenants.length > 0 && (
          <div class="mt-10">
            <h2 class="font-titre text-lg font-bold uppercase text-marine">Intervenants</h2>
            <ul class="mt-3 grid gap-3 sm:grid-cols-2">
              {data.intervenants.map((intervenant) => (
                <li class="rounded-2xl border border-marine/15 bg-brume p-4">
                  <p class="font-semibold text-marine">{intervenant.nom}</p>
                  {(intervenant.fonction || intervenant.organisme) && (
                    <p class="mt-1 text-sm text-encre/70">
                      {[intervenant.fonction, intervenant.organisme].filter(Boolean).join(' — ')}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        data.organisateur && (
          <p class="mt-8 text-sm text-encre">
            <span class="font-semibold text-marine">Organisé par :</span> {data.organisateur}
          </p>
        )
      }

      {
        (data.inscription_requise || data.capacite_limitee) && (
          <div class="mt-10 rounded-2xl border border-orange/30 bg-brume p-5">
            <h2 class="font-titre text-lg font-bold uppercase text-marine">Inscription</h2>
            <ul class="mt-2 space-y-2 text-sm text-encre">
              {data.capacite_limitee && <li class="font-semibold text-orange-dark">Capacité limitée</li>}
              {data.inscription_requise && (
                <li>
                  {data.lien_inscription ? (
                    <a
                      href={data.lien_inscription}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 rounded-md bg-orange-dark px-4 py-2.5 font-titre text-sm font-bold uppercase tracking-wide text-blanc transition-opacity hover:opacity-90"
                    >
                      S'inscrire (site externe)
                    </a>
                  ) : (
                    <span>Modalités d'inscription bientôt disponibles</span>
                  )}
                </li>
              )}
            </ul>
          </div>
        )
      }

      {
        exposantLie && (
          <p class="mt-8 text-sm text-encre">
            <span class="font-semibold text-marine">En lien avec :</span>{' '}
            <a href={`/exposants/${exposantSlug(exposantLie)}`} class="font-semibold text-marine underline">
              {exposantLie.data.nom}
            </a>
          </p>
        )
      }

      {
        dateMiseAJour && (
          <p class="mt-8 text-xs text-encre/70">Fiche mise à jour le {dateMiseAJour}.</p>
        )
      }

      <div class="mt-10 flex flex-col gap-3 border-t border-marine/10 pt-8 sm:flex-row">
        <a
          href="/programme"
          class="inline-flex items-center justify-center rounded-md bg-marine px-6 py-3 font-titre text-base font-bold uppercase tracking-wide text-blanc transition-opacity hover:opacity-90"
        >
          Retour au programme
        </a>
        {
          data.univers === 'village' && (
            <a
              href="/village"
              class="inline-flex items-center justify-center rounded-md border-2 border-marine px-6 py-3 font-titre text-base font-bold uppercase tracking-wide text-marine transition-colors hover:bg-marine hover:text-blanc"
            >
              Découvrir le Village Maintenance & Industrie
            </a>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
