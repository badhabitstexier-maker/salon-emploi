---
/*
  Intégration du formulaire Tally de candidature. Reçoit uniquement l'URL de
  base configurée (variable PUBLIC_TALLY_CANDIDATURE_URL, résolue au build) —
  ce composant ne construit pas l'URL finale : la page /candidater calcule les
  champs cachés (offres sélectionnées, orientation) côté client, puisque seule
  la sélection réelle du visiteur (dans l'URL du site) permet de le faire.

  Hauteur dynamique : l'URL construite par construireUrlTally() porte
  `dynamicHeight=1`, et le script officiel Tally (widgets/embed.js, chargé
  ci-dessous une seule fois) écoute les messages `Tally.FormHeightChanged`
  pour ajuster lui-même la hauteur de l'iframe à chaque étape du formulaire.
  Objectif : un seul scroll (celui de la page), jamais de scroll interne à
  l'iframe. Voir docs/CANDIDATURES_TALLY.md.

  Initialisation : ce composant se contente de charger widgets/embed.js. Il
  ne connaît pas encore l'URL complète (elle dépend de la sélection du
  visiteur, calculée côté page dans /candidater). C'est /candidater.astro qui
  affecte `data-tally-src` puis appelle `window.tallyInitEmbed()` (exposée
  ci-dessous) pour que le script Tally traite réellement l'iframe — suivre
  cet ordre est indispensable : lancer `Tally.loadEmbeds()` avant que
  `data-tally-src` existe ne redimensionne rien.

  Sans URL configurée : aucune iframe, aucun bouton mort — un état d'attente
  propre (voir docs/CANDIDATURES_TALLY.md, section « Configuration »).
*/
interface Props {
  tallyBaseUrl: string;
}

const { tallyBaseUrl } = Astro.props;
const configuree = tallyBaseUrl.trim().length > 0;
---

{
  configuree ? (
    <div class="w-full rounded-2xl border border-marine/15 bg-brume">
      <div class="relative min-h-[240px] w-full">
        <p id="tally-etat-chargement" class="p-6 text-sm text-encre">
          Chargement du formulaire de candidature…
        </p>
        <iframe
          id="tally-candidature-iframe"
          title="Formulaire de candidature — Salon de l'Emploi et de la Formation 2026"
          data-tally-base={tallyBaseUrl}
          class="hidden w-full border-0"
          style="height: 200px;"
        />
      </div>
      <noscript>
        <p class="border-t border-marine/15 bg-blanc p-6 text-sm text-encre">
          Ce formulaire nécessite JavaScript.{' '}
          <a href={tallyBaseUrl} class="font-semibold text-marine underline" target="_blank" rel="noopener noreferrer">
            Ouvrir le formulaire de candidature dans un nouvel onglet
          </a>
          .
        </p>
      </noscript>
      <script>
        // Chargement du script officiel Tally (une seule fois par page,
        // même si ce composant venait à être rendu plusieurs fois) : c'est
        // lui qui écoute les messages de redimensionnement envoyés par
        // l'iframe Tally et ajuste sa hauteur en conséquence.
        //
        // `tallyInitEmbed` (exposée sur window) doit être appelée par
        // /candidater.astro juste après avoir affecté `data-tally-src` sur
        // l'iframe — jamais avant, sous peine d'un scan Tally sur une iframe
        // sans URL, qui ne redimensionnera ensuite plus jamais l'iframe.
        const SRC_EMBED_TALLY = 'https://tally.so/widgets/embed.js';

        function initialiserTally(): void {
          const tally = (window as any).Tally;
          if (typeof tally !== 'undefined') {
            tally.loadEmbeds();
            return;
          }
          // Script pas encore chargé (ou en échec) : reprend le
          // comportement du snippet officiel Tally en affectant directement
          // `src` depuis `data-tally-src` sur les iframes en attente.
          document.querySelectorAll('iframe[data-tally-src]:not([src])').forEach((element) => {
            const iframeEnAttente = element as HTMLIFrameElement;
            if (iframeEnAttente.dataset.tallySrc) {
              iframeEnAttente.src = iframeEnAttente.dataset.tallySrc;
            }
          });
        }

        function chargerScriptTally(): void {
          if (document.querySelector(`script[src="${SRC_EMBED_TALLY}"]`)) return;
          const script = document.createElement('script');
          script.src = SRC_EMBED_TALLY;
          script.onload = initialiserTally;
          script.onerror = initialiserTally;
          document.body.appendChild(script);
        }

        (window as any).tallyInitEmbed = initialiserTally;
        chargerScriptTally();
      </script>
    </div>
  ) : (
    <div class="rounded-2xl border border-marine/15 bg-brume p-6 text-center sm:p-8">
      <p class="font-titre text-lg font-bold uppercase text-marine">
        Le formulaire de candidature sera prochainement disponible.
      </p>
    </div>
  )
}
