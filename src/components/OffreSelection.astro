---
/*
  Gabarit HTML d'une ligne de sélection — un <template>, jamais rendu tel
  quel : cloné et rempli côté client par src/lib/selection-ui.ts, dans le
  tiroir (SelectionDrawer) comme sur /ma-selection. Un seul exemplaire par
  page (id unique).
*/
---

<template id="modele-ligne-selection">
  <li
    data-ligne-selection
    class="flex items-start justify-between gap-3 rounded-xl border border-marine/15 bg-blanc p-3"
  >
    <div class="min-w-0">
      <p class="text-xs font-bold uppercase tracking-wide text-orange-dark" data-champ="reference"></p>
      <p class="truncate font-titre text-base font-bold uppercase leading-tight text-marine" data-champ="intitule"></p>
      <p class="truncate text-xs text-encre/70" data-champ="exposant"></p>
      <a
        href="#"
        data-champ="lien"
        class="mt-1 inline-block text-xs font-semibold text-marine underline underline-offset-2 hover:text-orange-dark"
      >
        Voir la fiche
      </a>
    </div>
    <button
      type="button"
      data-action="retirer"
      class="flex-shrink-0 rounded-md border border-marine/20 px-2.5 py-1.5 text-xs font-semibold text-marine transition-colors hover:bg-marine hover:text-blanc"
    >
      Retirer
    </button>
  </li>
</template>
