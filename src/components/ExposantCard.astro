---
import { universLabels, typeStructureLabels, formulePubliqueLabels, exposantSlug, type Exposant } from '../lib/exposants';

interface Props {
  exposant: Exposant;
}

const { exposant } = Astro.props;
const { data } = exposant;
const slug = exposantSlug(exposant);

const styleUnivers = {
  emploi: { badge: 'bg-marine text-blanc', bordure: 'border-marine/15', accent: 'text-orange-dark' },
  formation: { badge: 'bg-village-dark text-blanc', bordure: 'border-village/30', accent: 'text-village-dark' },
}[data.univers];

/*
  Champ utilisé par le filtrage JS côté client (section exposants.astro) :
  concatène les valeurs recherchables en minuscules, sans accents, pour une
  recherche texte simple sans dépendance.
*/
const normaliser = (valeur: string) =>
  valeur
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '');

const texteRecherche = normaliser(
  [data.nom, data.accroche, ...data.secteurs, ...(data.mots_cles ?? [])].join(' '),
);
---

<article
  class:list={['flex flex-col overflow-hidden rounded-2xl border bg-blanc', styleUnivers.bordure]}
  data-exposant-card
  data-nom={data.nom}
  data-univers={data.univers}
  data-type={data.type_structure}
  data-secteurs={data.secteurs.join('|')}
  data-search={texteRecherche}
>
  <div class="relative flex h-28 items-center justify-center border-b border-marine/10 bg-brume p-4">
    {
      data.demo && (
        <span class="absolute left-2 top-2 w-fit rounded-full bg-encre/85 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-blanc">
          Fiche de démonstration
        </span>
      )
    }
    {
      data.logo ? (
        <img src={data.logo} alt="" class="max-h-full max-w-full object-contain" loading="lazy" />
      ) : (
        <svg
          class="h-10 w-10 text-marine/25"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <rect x="3" y="7.5" width="18" height="12" rx="1.8" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.5 7.5V6a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v1.5" />
        </svg>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="flex flex-wrap items-center gap-1.5">
      <span class:list={['w-fit rounded-full px-2.5 py-1 text-xs font-bold uppercase tracking-wide', styleUnivers.badge]}>
        {universLabels[data.univers]}
      </span>
      {
        data.formule !== 'standard' && (
          <span class="w-fit rounded-full border border-orange/50 bg-orange/10 px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-orange-dark">
            {formulePubliqueLabels[data.formule]}
          </span>
        )
      }
    </div>

    <h3 class="mt-3 font-titre text-xl font-bold uppercase leading-tight text-marine">{data.nom}</h3>
    <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-encre/70">
      {typeStructureLabels[data.type_structure]}
    </p>

    {
      data.secteurs.length > 0 && (
        <p class="mt-2 text-xs text-encre/70">{data.secteurs.join(' · ')}</p>
      )
    }

    <p class="mt-3 flex-1 text-sm text-encre">{data.accroche}</p>

    {
      data.numero_stand && (
        <p class:list={['mt-3 text-sm font-bold', styleUnivers.accent]}>Stand {data.numero_stand}</p>
      )
    }

    <a
      href={`/exposants/${slug}`}
      class="mt-4 inline-flex w-fit items-center gap-1.5 rounded-md bg-marine px-4 py-2.5 font-titre text-sm font-bold uppercase tracking-wide text-blanc transition-opacity hover:opacity-90"
    >
      Découvrir cet exposant
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</article>
