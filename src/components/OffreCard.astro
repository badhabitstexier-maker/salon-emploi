---
import { formuleLabels, offreSlug, estRecente, estOffreTest, type Offre } from '../lib/offres';

interface Props {
  offre: Offre;
}

const { offre } = Astro.props;
const { data } = offre;
const slug = offreSlug(offre);
const testOffre = estOffreTest(offre);

const badgeFormule = data.formule === 'silver' || data.formule === 'gold' ? formuleLabels[data.formule] : null;

const formateurDate = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' });

/*
  Champ utilisé par le filtrage JS côté client (OffreFilters.astro) :
  concatène les valeurs recherchables en minuscules, sans accents, pour une
  recherche texte simple sans dépendance (même convention qu'ExposantCard).
*/
const normaliser = (valeur: string) =>
  valeur
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '');

const texteRecherche = normaliser(
  [data.reference, data.intitule, data.exposantNom, data.secteur, data.lieu, ...data.missions].join(' '),
);
---

<article
  class="flex flex-col overflow-hidden rounded-2xl border border-marine/15 bg-blanc"
  data-offre-card
  data-reference={data.reference}
  data-entreprise={data.exposantNom}
  data-secteur={data.secteur}
  data-types-contrat={data.typeContrat.join('|')}
  data-lieu={data.lieu}
  data-niveaux={data.niveauFormation.join('|')}
  data-sans-experience={String(data.sansExperience)}
  data-recent={String(estRecente(offre))}
  data-search={texteRecherche}
>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex flex-wrap items-center gap-2">
      <span class="w-fit rounded-full bg-marine px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-blanc">
        {data.reference}
      </span>
      {
        badgeFormule && (
          <span class="w-fit rounded-full border border-marine/20 px-2.5 py-1 text-xs font-semibold text-marine/70">
            {badgeFormule}
          </span>
        )
      }
      {
        data.sansExperience && (
          <span class="w-fit rounded-full bg-village px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-marine">
            Débutant accepté
          </span>
        )
      }
    </div>

    <h3 class="mt-3 font-titre text-xl font-bold uppercase leading-tight text-marine">{data.intitule}</h3>
    <p class="mt-1 text-sm font-semibold text-encre/80">{data.exposantNom}</p>

    <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs font-semibold uppercase tracking-wide text-encre/70">
      <li>{data.secteur}</li>
      <li>{data.typeContrat.join(' · ')}</li>
      <li>{data.lieu}</li>
    </ul>

    <p class="mt-3 flex-1 text-sm text-encre">{data.descriptionCourte}</p>

    <ul class="mt-4 space-y-1 text-xs text-encre/70">
      <li>
        {data.nombrePostes} {data.nombrePostes > 1 ? 'postes à pourvoir' : 'poste à pourvoir'}
      </li>
      <li>Niveau d'expérience : {data.niveauExperience}</li>
      <li>Publiée le {formateurDate.format(data.datePublication)}</li>
    </ul>

    <div class="mt-5 flex flex-col gap-2 sm:flex-row">
      <a
        href={`/offres/${slug}`}
        data-preserve-selection
        data-href-base={`/offres/${slug}`}
        class="inline-flex flex-1 items-center justify-center rounded-md bg-marine px-4 py-2.5 font-titre text-sm font-bold uppercase tracking-wide text-blanc transition-opacity hover:opacity-90"
      >
        Voir l'offre
      </a>
      {
        !testOffre && (
          <button
            type="button"
            data-offre-toggle={data.reference}
            aria-pressed="false"
            class="inline-flex flex-1 items-center justify-center rounded-md border-2 border-village px-4 py-2.5 font-titre text-sm font-bold uppercase tracking-wide text-marine transition-colors hover:bg-village"
          >
            Ajouter à ma sélection
          </button>
        )
      }
    </div>
  </div>
</article>
