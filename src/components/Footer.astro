---
const year = new Date().getFullYear();

const liensSalon = [
  { href: '/le-salon', label: 'Le salon' },
  { href: '/village', label: 'Village Maintenance & Industrie' },
  { href: '/exposants', label: 'Exposants' },
];

const liensVisite = [
  { href: '/programme', label: 'Programme' },
  { href: '/preparer-ma-visite', label: 'Préparer ma visite' },
  { href: '/exposer', label: 'Exposer' },
];
---

<footer class="bg-marine text-brume">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="flex flex-col gap-8 lg:flex-row lg:justify-between lg:gap-12">
      <div class="max-w-sm">
        <div class="flex items-center gap-2.5">
          <span
            class="flex h-9 w-9 flex-none items-center justify-center rounded-md bg-orange text-sm font-black leading-none text-blanc"
            aria-hidden="true">SE</span
          >
          <p class="text-sm font-extrabold uppercase leading-tight text-blanc">
            Salon de l'Emploi<br />&amp; de la Formation 2026
          </p>
        </div>
        <p class="mt-4 text-sm leading-relaxed">
          30 et 31 octobre 2026 — Salle d'exposition de Nouville, Nouméa.<br />
          Entrée libre et gratuite.
        </p>
      </div>

      <div class="grid gap-8 sm:grid-cols-2 sm:gap-12">
        <nav aria-label="Le salon">
          <p class="text-xs font-bold uppercase tracking-widest text-orange">Le salon</p>
          <ul class="mt-3 space-y-2 text-sm">
            {liensSalon.map((lien) => <li><a class="transition-colors hover:text-orange" href={lien.href}>{lien.label}</a></li>)}
          </ul>
        </nav>

        <nav aria-label="Participer">
          <p class="text-xs font-bold uppercase tracking-widest text-orange">Participer</p>
          <ul class="mt-3 space-y-2 text-sm">
            {liensVisite.map((lien) => <li><a class="transition-colors hover:text-orange" href={lien.href}>{lien.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </div>

    <div
      class="mt-8 flex flex-col gap-3 border-t border-blanc/10 pt-5 text-xs sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-brume/80">
        &copy; {year} LabEvents — Organisateur du Salon de l'Emploi &amp; de la Formation.
      </p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        <li><a class="transition-colors hover:text-orange" href="/mentions-legales">Mentions légales</a></li>
        <li>
          <a class="transition-colors hover:text-orange" href="/confidentialite">Politique de confidentialité</a>
        </li>
      </ul>
    </div>
  </div>
</footer>
