---
const year = new Date().getFullYear();
---

<footer class="bg-marine text-brume">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <p class="text-lg font-bold text-blanc">Salon de l'Emploi &amp; de la Formation 2026</p>
        <p class="mt-2 text-sm">
          30 et 31 octobre 2026 — Salle d'exposition de Nouville, Nouméa.<br />
          Entrée libre et gratuite.
        </p>
      </div>

      <nav aria-label="Plan du site">
        <p class="text-sm font-semibold uppercase tracking-wide text-blanc">Le salon</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="hover:text-orange" href="/le-salon">Le salon</a></li>
          <li><a class="hover:text-orange" href="/village">Village Maintenance &amp; Industrie</a></li>
          <li><a class="hover:text-orange" href="/exposants">Exposants</a></li>
          <li><a class="hover:text-orange" href="/programme">Programme</a></li>
          <li><a class="hover:text-orange" href="/preparer-ma-visite">Préparer ma visite</a></li>
          <li><a class="hover:text-orange" href="/exposer">Exposer</a></li>
        </ul>
      </nav>

      <nav aria-label="Informations légales">
        <p class="text-sm font-semibold uppercase tracking-wide text-blanc">Informations</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="hover:text-orange" href="/mentions-legales">Mentions légales</a></li>
          <li><a class="hover:text-orange" href="/confidentialite">Politique de confidentialité</a></li>
        </ul>
      </nav>
    </div>

    <p class="mt-10 border-t border-white/10 pt-6 text-xs text-brume/80">
      &copy; {year} LabEvents — Organisateur du Salon de l'Emploi &amp; de la Formation. Tous droits réservés.
    </p>
  </div>
</footer>
