---
const year = new Date().getFullYear();

const liens = [
  { href: '/le-salon', label: 'Le salon' },
  { href: '/village', label: 'Village Maintenance & Industrie' },
  { href: '/exposants', label: 'Exposants' },
  { href: '/programme', label: 'Programme' },
  { href: '/preparer-ma-visite', label: 'Préparer ma visite' },
  { href: '/exposer', label: 'Exposer' },
];
---

<footer class="bg-marine text-brume">
  <div class="mx-auto max-w-6xl px-4 py-9 sm:px-6">
    <div class="flex flex-col gap-7 lg:flex-row lg:items-start lg:justify-between lg:gap-10">
      <div>
        <p class="font-titre text-sm font-bold uppercase leading-none text-blanc">
          <span class="block text-xl leading-none">Salon</span>
          <span class="mt-0.5 block leading-none">De l'Emploi <span class="text-orange">&amp;</span></span>
          <span class="mt-0.5 block leading-none">De la Formation 2026</span>
        </p>
        <p class="mt-4 text-sm leading-relaxed">
          30 et 31 octobre 2026 — Salle d'exposition de Nouville, Nouméa.<br />
          Entrée libre et gratuite.
        </p>
      </div>

      <nav aria-label="Plan du site" class="lg:max-w-md">
        <ul class="grid grid-cols-1 gap-x-8 gap-y-2 text-sm sm:grid-cols-2">
          {liens.map((lien) => <li><a class="transition-colors hover:text-orange" href={lien.href}>{lien.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div
      class="mt-8 flex flex-col gap-3 border-t border-blanc/10 pt-5 text-xs sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-brume/80">&copy; {year} LabEvents — Organisateur du salon. Tous droits réservés.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        <li><a class="transition-colors hover:text-orange" href="/mentions-legales">Mentions légales</a></li>
        <li>
          <a class="transition-colors hover:text-orange" href="/confidentialite">Politique de confidentialité</a>
        </li>
      </ul>
    </div>
  </div>
</footer>
