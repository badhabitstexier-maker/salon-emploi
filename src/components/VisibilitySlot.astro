---
/*
  Emplacement de visibilité publicitaire (Lot Admin-2 / Admin-2B, voir
  docs/VISIBILITE.md). Centralise le balisage : les pages appelantes ne font
  que déclarer `page` + `emplacement`, jamais de règle publicitaire écrite
  en dur dans la page.

  CHANGEMENT Admin-2B : jusqu'ici, ce composant interrogeait
  `getCollection('visibilites')` AU BUILD et ne rendait la <section> que
  s'il existait au moins une campagne envoyable — impossible depuis
  Admin-2B, puisque les campagnes vivent uniquement dans visibilites.json
  sur le serveur (voir public/api/visibilites.php), inconnu d'Astro au
  moment du build. La <section> est donc désormais TOUJOURS rendue, mais
  masquée par défaut (`hidden`) : c'est le contrôleur client
  (src/lib/visibilite-ui.ts) qui va chercher les candidats via l'API
  publique et ne révèle la section que s'il en trouve un éligible. Le
  résultat visible pour un visiteur est identique (aucun espace vide tant
  qu'aucun tirage n'a abouti) — voir cadrage Admin-2B §5/§12.

  CHANGEMENT ratio libre (voir docs/VISIBILITE.md §5bis) : plus d'aspect
  ratio forcé (6:1 mobile / 8:1 desktop) ni de crop `object-cover`. Le
  conteneur n'impose plus de hauteur : c'est l'image (rendue par
  src/lib/visibilite-ui.ts) qui dicte la hauteur via son ratio naturel,
  seule sa largeur reste contrainte à 100% du slot.
*/
import type { PageVisibilite, EmplacementVisibilite } from '../lib/visibilites';

interface Props {
  page: PageVisibilite;
  emplacement?: EmplacementVisibilite;
}

const { page, emplacement = 'principal' } = Astro.props;
const idSection = `visibilite-slot-${page}-${emplacement}`;
---

<section
  id={idSection}
  data-visibility-page={page}
  data-visibility-emplacement={emplacement}
  class="hidden border-t border-marine/10 bg-brume"
  aria-label="Espace partenaires"
>
  <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
    <div
      data-visibility-visual
      class="w-full overflow-hidden rounded-xl bg-marine/5"
    />
  </div>
</section>
<script>
  import { initAllVisibilitySlots } from '../lib/visibilite-ui';
  initAllVisibilitySlots();
</script>
