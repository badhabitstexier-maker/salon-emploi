---
import { universLabels, typeLabels, programmeSlug, type ProgrammeItem } from '../lib/programme';

interface Props {
  item: ProgrammeItem;
}

const { item } = Astro.props;
const { data } = item;
const slug = programmeSlug(item);

const styleUnivers = {
  hall: { badge: 'bg-marine text-blanc', bordure: 'border-marine/15', accent: 'text-orange' },
  village: { badge: 'bg-village text-blanc', bordure: 'border-village/30', accent: 'text-village' },
  transversal: { badge: 'bg-encre text-blanc', bordure: 'border-encre/15', accent: 'text-encre' },
}[data.univers];

/*
  Champ utilisé par le filtrage JS côté client (section programme.astro) :
  concatène les valeurs recherchables en minuscules, sans accents, pour une
  recherche texte simple sans dépendance.
*/
const normaliser = (valeur: string) =>
  valeur
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '');

const nomsIntervenants = (data.intervenants ?? []).map((intervenant) => intervenant.nom);

const texteRecherche = normaliser(
  [data.titre, data.accroche, ...nomsIntervenants].join(' '),
);
---

<article
  class:list={[
    'flex flex-col overflow-hidden rounded-2xl border bg-blanc',
    data.mise_en_avant ? 'border-2 border-orange' : styleUnivers.bordure,
  ]}
  data-programme-card
  data-date={data.date}
  data-univers={data.univers}
  data-type={data.type}
  data-publics={(data.publics ?? []).join('|')}
  data-search={texteRecherche}
>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex flex-wrap items-center gap-2">
      {
        data.mise_en_avant && (
          <span class="w-fit rounded-full bg-orange px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-blanc">
            Temps fort
          </span>
        )
      }
      <span class:list={['w-fit rounded-full px-2.5 py-1 text-xs font-bold uppercase tracking-wide', styleUnivers.badge]}>
        {universLabels[data.univers]}
      </span>
      <span class="w-fit rounded-full border border-marine/20 px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-marine">
        {typeLabels[data.type]}
      </span>
    </div>

    <p class:list={['mt-3 font-titre text-lg font-bold', styleUnivers.accent]}>
      {data.heure_debut}{data.heure_fin ? `–${data.heure_fin}` : ''}
    </p>

    <h3 class="mt-1 font-titre text-xl font-bold uppercase leading-tight text-marine">{data.titre}</h3>

    {
      data.lieu && (
        <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-encre/60">{data.lieu}</p>
      )
    }

    <p class="mt-3 flex-1 text-sm text-encre">{data.accroche}</p>

    {
      nomsIntervenants.length > 0 && (
        <p class="mt-3 text-xs text-encre/70">{nomsIntervenants.join(' · ')}</p>
      )
    }

    {
      (data.inscription_requise || data.capacite_limitee) && (
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs font-bold uppercase tracking-wide text-orange">
          {data.inscription_requise && <li>Inscription requise</li>}
          {data.capacite_limitee && <li>Capacité limitée</li>}
        </ul>
      )
    }

    <a
      href={`/programme/${slug}`}
      class="mt-4 inline-flex w-fit items-center gap-1.5 rounded-md bg-marine px-4 py-2.5 font-titre text-sm font-bold uppercase tracking-wide text-blanc transition-opacity hover:opacity-90"
    >
      Voir le détail
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</article>
