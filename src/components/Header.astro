---
const navLinks = [
  { href: '/', label: 'Accueil' },
  { href: '/le-salon', label: 'Le salon' },
  { href: '/village', label: 'Village' },
  { href: '/exposants', label: 'Exposants' },
  { href: '/programme', label: 'Programme' },
  { href: '/preparer-ma-visite', label: 'Préparer ma visite' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<!-- Bandeau événementiel : rappel permanent des faits clés (non collant) -->
<div class="hidden bg-orange text-blanc md:block">
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-4 gap-y-1 px-4 py-1.5 text-xs font-bold uppercase tracking-wide sm:px-6"
  >
    <span>30 &amp; 31 octobre 2026</span>
    <span aria-hidden="true" class="opacity-60">•</span>
    <span>Salle d'exposition de Nouville — Nouméa</span>
    <span aria-hidden="true" class="opacity-60">•</span>
    <span>Entrée libre et gratuite</span>
  </div>
</div>

<header class="sticky top-0 z-50 bg-marine text-blanc shadow-lg">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-3 px-4 sm:px-6 lg:h-16 lg:gap-6">
    <a href="/" class="flex min-w-0 flex-shrink-0 items-center gap-2.5" aria-label="Accueil du salon">
      <span
        class="flex h-9 w-9 flex-none items-center justify-center rounded-md bg-orange text-sm font-black leading-none text-blanc lg:h-10 lg:w-10"
        aria-hidden="true">SE</span
      >
      {/*
        Bloc-titre à deux régimes : version compacte sur deux lignes quand la
        place manque (mobile, et créneau lg où la nav desktop apparaît),
        version sur une ligne quand la largeur le permet (sm→md et xl+).
      */}
      <span class="min-w-0 leading-tight">
        <span class="block text-xs font-extrabold uppercase tracking-tight sm:hidden lg:block xl:hidden">
          Salon de l'Emploi<br />&amp; de la Formation
        </span>
        <span
          class="hidden whitespace-nowrap text-sm font-extrabold uppercase tracking-tight sm:block lg:hidden xl:block xl:text-base"
        >
          Salon de l'Emploi &amp; de la Formation
        </span>
        <span class="hidden text-xs font-medium text-brume/70 sm:block lg:hidden xl:block">Nouméa · 2026</span>
      </span>
    </a>

    <nav class="ml-auto hidden lg:block" aria-label="Navigation principale">
      <ul class="flex items-center gap-x-5 text-sm font-semibold xl:gap-x-7">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'relative block whitespace-nowrap py-1 transition-colors hover:text-orange',
                  isActive(link.href) ? 'text-orange' : 'text-blanc',
                ]}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
                {isActive(link.href) && (
                  <span class="absolute inset-x-0 -bottom-1 h-0.5 rounded-full bg-orange" aria-hidden="true" />
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href="/exposer"
      class="ml-auto hidden whitespace-nowrap rounded-md bg-village px-4 py-2 text-sm font-bold text-blanc transition-opacity hover:opacity-90 lg:ml-0 lg:inline-block"
    >
      Devenir exposant
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="ml-auto inline-flex flex-shrink-0 items-center justify-center rounded-md p-2 text-blanc lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Ouvrir le menu"
    >
      <svg id="icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-blanc/10 bg-marine lg:hidden" aria-label="Navigation mobile">
    <ul class="flex flex-col gap-1 px-4 py-3 text-base font-semibold sm:px-6">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'block rounded-md px-3 py-2 transition-colors hover:bg-blanc/10',
                isActive(link.href) ? 'bg-blanc/5 text-orange' : 'text-blanc',
              ]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a href="/exposer" class="block rounded-md bg-village px-3 py-2.5 text-center font-bold text-blanc">
          Devenir exposant
        </a>
      </li>
      <li class="px-3 pb-1 pt-3 text-xs font-medium uppercase tracking-wide text-brume/70 md:hidden">
        30 &amp; 31 octobre 2026 · Nouville, Nouméa · Entrée libre
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-label', expanded ? 'Ouvrir le menu' : 'Fermer le menu');
  });
</script>
