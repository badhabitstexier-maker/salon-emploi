{
  "name": "salon-emploi",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Site du Salon de l'Emploi & de la Formation 2026 — Nouméa",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "offres:import": "node scripts/import-offres.mjs",
    "offres:check": "node scripts/import-offres.mjs --check",
    "offres:test": "node --test scripts/import-offres.test.mjs",
    "exposants:import": "node scripts/import-exposants.mjs",
    "exposants:check": "node scripts/import-exposants.mjs --check",
    "exposants:test": "node --test scripts/import-exposants.test.mjs",
    "programme:import": "node scripts/import-programme.mjs",
    "programme:check": "node scripts/import-programme.mjs --check",
    "programme:test": "node --test scripts/import-programme.test.mjs",
    "content:check": "node scripts/check-public-content.mjs",
    "content:test": "npm run offres:test && npm run exposants:test && npm run programme:test && npm run visibilites:test && npm run json-inline:test && npm run visibilites:deploy-config-test && npm run visibilites:deploy-injection-test && npm run content:check",
    "visibilites:test": "node --test scripts/visibilites-lib.test.mjs",
    "json-inline:test": "node --test scripts/json-inline.test.mjs",
    "visibilites:api-test": "node --test scripts/visibilites-api.test.mjs",
    "visibilites:deploy-config-test": "node --test scripts/visibilites-deploy-config.test.mjs",
    "visibilites:deploy-injection-test": "node --test scripts/visibilite-deploy-injection.test.mjs",
    "qa:e2e": "playwright test",
    "qa": "npm run qa:e2e"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "astro-robots-txt": "^1.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1"
  }
}
