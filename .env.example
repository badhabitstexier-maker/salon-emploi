# URL absolue du site pour l'environnement courant (avec https://, sans slash final).
# Utilisée pour astro.config.mjs (site), les URL canoniques, les métadonnées
# Open Graph, le sitemap et les redirections Web3Forms.
# - Préproduction : https://preprod.salonemploinc.com
# - Production    : URL définitive du site
# - Non définie   : repli sur http://localhost:4321 (développement local)
PUBLIC_SITE_URL=

# "true" pour empêcher l'indexation du site (préproduction) : ajoute une balise
# meta robots noindex,nofollow, bloque l'indexation dans robots.txt et
# désactive la génération du sitemap. Absente ou "false" en production.
PUBLIC_NOINDEX=false

# Clé d'accès Web3Forms — ne jamais committer la vraie valeur.
PUBLIC_WEB3FORMS_ACCESS_KEY=VOTRE_CLE_WEB3FORMS

# URL du formulaire Tally de candidature (Lot 2 — voir docs/CANDIDATURES_TALLY.md).
# Non secrète, mais laissée vide par défaut : tant qu'elle n'est pas définie,
# /candidater affiche un état d'attente propre (pas d'iframe cassée).
# Exemple documentaire uniquement : PUBLIC_TALLY_CANDIDATURE_URL=https://tally.so/r/XXXXXXXX
PUBLIC_TALLY_CANDIDATURE_URL=
